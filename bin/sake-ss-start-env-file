#!/usr/bin/env bash
# Improved interactive sake-ss-start-env-file
# Asks for all values with defaults, generates .env.yml, then builds .env

############################################ PARSE ARGUMENTS
SCRIPT_DIR="${COMPOSER_RUNTIME_BIN_DIR:?COMPOSER_RUNTIME_BIN_DIR not set}"
WORKING_DIR=$(pwd)
source "$SCRIPT_DIR/sake-self-methods"
SCRIPT_SUMMARY="Generates a SilverStripe .env file from YAML configuration data"

# Default yml file location
YMLFILELOCATION='.env.yml'
YMLFILECREATE='no'

# Parse command line arguments
while (($#)); do
    case $1 in
    -c | --createymlfile)
        YMLFILECREATE='yes'
        ;;
    -y | --ymlfilelocation)
        YMLFILELOCATION=$2
        shift
        ;;
    -h | --help)
        help_and_exit
        ;;
    *)
        if ! sake_handle_help_flag "$1"; then
            :
        fi
        ;;
    esac
    shift
done

help_and_exit() {

    ECHOHEAD "Create a .env file for Silverstripe based on a yml file of data"
    echonice "$SCRIPT_SUMMARY"
    echonice ""
    echonice "If the yml file does not exist yet, it is created for you to complete."
    echonice "Once the yml file exists, running again builds the .env file from it."
    echonice ""
    echonice "Directory of script:           $SCRIPT_DIR"
    echonice "Directory to use:              $WORKING_DIR"

    ECHOHEAD "Available settings:"
    echonice "-c, --createymlfile            (re)create the yml file to enter data"
    echonice "                            -> $YMLFILECREATE"
    echonice "-y, --ymlfilelocation          location of the yml file:"
    echonice "                            -> $YMLFILELOCATION"
    echonice "-h, --help                     show help information"

    ECHOHEAD "Example usage:"
    echonice "sake-ss-start-env-file                 # create yml if missing, otherwise build .env"
    echonice "sake-ss-start-env-file -c              # (re)create the yml file to complete data"
    echonice "sake-ss-start-env-file -y myenv.yml    # use a different yml file"

    echofunctions
    exit
}

sake_check_help_and_exit() {
    if [[ "$1" == "-h" || "$1" == "--help" ]]; then
        help_and_exit
    fi
}

############################################ RESOLVE DIRECTORY AND YML PATH
case "$YMLFILELOCATION" in
    /*) : ;;
    *) YMLFILELOCATION="$WORKING_DIR/$YMLFILELOCATION" ;;
esac
YMLFILELOCATION=$(realpath -m "$YMLFILELOCATION")
ENVFILELOCATION=$(realpath -m "$WORKING_DIR/.env")

############################################ INTERACTIVE PROMPTS
# Get current directory information for educated defaults
CURRENT_DIR=$(pwd)
CURRENT_DIR_NAME=$(basename "$CURRENT_DIR")
CURRENT_DIR_BASENAME=$(basename "$CURRENT_DIR" | tr '.' '_')

echo "=== Basics ==="
# Default includes http:// protocol, user can override
SS_BASE_URL_DEFAULT="http://${CURRENT_DIR_NAME}.ss4"
read -p "SS_BASE_URL [$SS_BASE_URL_DEFAULT]: " SS_BASE_URL
SS_BASE_URL=${SS_BASE_URL:-$SS_BASE_URL_DEFAULT}

read -p "SS_ENVIRONMENT_TYPE [dev]: " SS_ENVIRONMENT_TYPE
SS_ENVIRONMENT_TYPE=${SS_ENVIRONMENT_TYPE:-dev}

read -p "SS_ALLOWED_HOSTS [${CURRENT_DIR_NAME}.ss4]: " SS_ALLOWED_HOSTS
SS_ALLOWED_HOSTS=${SS_ALLOWED_HOSTS:-${CURRENT_DIR_NAME}.ss4}
# SS_ALLOWED_HOSTS="add your domain here, e.g. www.mydomain.com"

read -p "SS_HOSTED_WITH_SITEHOST [false]: " SS_HOSTED_WITH_SITEHOST
SS_HOSTED_WITH_SITEHOST=${SS_HOSTED_WITH_SITEHOST:-false}

echo ""
echo "=== Paths ==="
# Full path for TEMP default (not relative)
TEMP_PATH_DEFAULT="$CURRENT_DIR/tmp"
read -p "TEMP_PATH [$TEMP_PATH_DEFAULT]: " TEMP_PATH
TEMP_PATH=${TEMP_PATH:-$TEMP_PATH_DEFAULT}

echo ""
echo "=== DB ==="
# Replace dots with underscores for valid database name
SS_DATABASE_NAME_DEFAULT="${CURRENT_DIR_BASENAME}"
read -p "SS_DATABASE_SERVER [localhost]: " SS_DATABASE_SERVER
SS_DATABASE_SERVER=${SS_DATABASE_SERVER:-localhost}

read -p "SS_DATABASE_NAME [$SS_DATABASE_NAME_DEFAULT]: " SS_DATABASE_NAME
SS_DATABASE_NAME=${SS_DATABASE_NAME:-$SS_DATABASE_NAME_DEFAULT}

read -p "SS_DATABASE_USERNAME [root]: " SS_DATABASE_USERNAME
SS_DATABASE_USERNAME=${SS_DATABASE_USERNAME:-root}

read -p "SS_DATABASE_PASSWORD [x]: " SS_DATABASE_PASSWORD
SS_DATABASE_PASSWORD=${SS_DATABASE_PASSWORD:-x}

read -p "SS_DATABASE_CLASS [MySQLDatabase]: " SS_DATABASE_CLASS
SS_DATABASE_CLASS=${SS_DATABASE_CLASS:-MySQLDatabase}

echo ""
echo "=== Logins ==="
read -p "SS_BASIC_AUTH_USER [x]: " SS_BASIC_AUTH_USER
SS_BASIC_AUTH_USER=${SS_BASIC_AUTH_USER:-x}

read -p "SS_BASIC_AUTH_PASSWORD [x]: " SS_BASIC_AUTH_PASSWORD
SS_BASIC_AUTH_PASSWORD=${SS_BASIC_AUTH_PASSWORD:-x}

read -p "SS_USE_BASIC_AUTH [false]: " SS_USE_BASIC_AUTH
SS_USE_BASIC_AUTH=${SS_USE_BASIC_AUTH:-false}

read -p "SS_DEFAULT_ADMIN_USERNAME [x]: " SS_DEFAULT_ADMIN_USERNAME
SS_DEFAULT_ADMIN_USERNAME=${SS_DEFAULT_ADMIN_USERNAME:-x}

read -p "SS_DEFAULT_ADMIN_PASSWORD [x]: " SS_DEFAULT_ADMIN_PASSWORD
SS_DEFAULT_ADMIN_PASSWORD=${SS_DEFAULT_ADMIN_PASSWORD:-x}

read -p "BYPASS_MFA [true]: " BYPASS_MFA
BYPASS_MFA=${BYPASS_MFA:-true}

echo ""
echo "=== Debug and Development ==="
read -p "SS_ERROR_LOG (optional, press enter to skip): " SS_ERROR_LOG

read -p "SS_SERVER_FOR_EXAMPLE_DATA (optional, press enter to skip): " SS_SERVER_FOR_EXAMPLE_DATA

# SS_ALLOW_SMOKE_TEST defaults to true for dev environments
read -p "SS_ALLOW_SMOKE_TEST [true]: " SS_ALLOW_SMOKE_TEST
SS_ALLOW_SMOKE_TEST=${SS_ALLOW_SMOKE_TEST:-true}

echo ""
echo "=== Release ==="
read -p "SS_RELEASE_BRANCH [develop]: " SS_RELEASE_BRANCH
SS_RELEASE_BRANCH=${SS_RELEASE_BRANCH:-develop}

read -p "FIA_RELEASE_PING_URL [tbc]: " FIA_RELEASE_PING_URL
FIA_RELEASE_PING_URL=${FIA_RELEASE_PING_URL:-tbc}

echo ""
echo "=== Secrets ==="
# Generate real random strings for MFA and session keys
SS_MFA_SECRET_KEY_DEFAULT=$(cat /dev/urandom | tr -dc 'a-zA-Z0-9' | fold -w 32 | head -n 1)
SS_SESSION_KEY_DEFAULT=$(cat /dev/urandom | tr -dc 'a-zA-Z0-9' | fold -w 32 | head -n 1)

read -p "SS_MFA_SECRET_KEY [$SS_MFA_SECRET_KEY_DEFAULT]: " SS_MFA_SECRET_KEY
SS_MFA_SECRET_KEY=${SS_MFA_SECRET_KEY:-$SS_MFA_SECRET_KEY_DEFAULT}

read -p "SS_SESSION_KEY [$SS_SESSION_KEY_DEFAULT]: " SS_SESSION_KEY
SS_SESSION_KEY=${SS_SESSION_KEY:-$SS_SESSION_KEY_DEFAULT}

echo ""
echo "=== Email ==="
read -p "SS_SEND_ALL_EMAILS_TO [support.team@sunnysideup.co.nz]: " SS_SEND_ALL_EMAILS_TO
SS_SEND_ALL_EMAILS_TO=${SS_SEND_ALL_EMAILS_TO:-support.team@sunnysideup.co.nz}

echo ""
echo "=== Branding ==="
read -p "SS_WHITE_LABEL_ONLY [false]: " SS_WHITE_LABEL_ONLY
SS_WHITE_LABEL_ONLY=${SS_WHITE_LABEL_ONLY:-false}

############################################ GENERATE YML FILE
echo ""
echo "=== Generating .env.yml file ==="

# Build the YAML content piece by piece to avoid heredoc issues
YML_CONTENT="# Basics\n"
YML_CONTENT+="WebsiteURL: \"$SS_BASE_URL\"\n"
YML_CONTENT+="Branch: \"$SS_RELEASE_BRANCH\"\n"
YML_CONTENT+="DBServer: \"$SS_DATABASE_SERVER\"\n"
YML_CONTENT+="DBName: \"$SS_DATABASE_NAME\"\n"
YML_CONTENT+="DBUser: \"$SS_DATABASE_USERNAME\"\n"
YML_CONTENT+="DBPassword: \"$SS_DATABASE_PASSWORD\"\n"
YML_CONTENT+="BasicAuthUser: \"$SS_BASIC_AUTH_USER\"\n"
YML_CONTENT+="BasicAuthPassword: \"$SS_BASIC_AUTH_PASSWORD\"\n"
YML_CONTENT+="EnvironmentType: \"$SS_ENVIRONMENT_TYPE\"\n"
YML_CONTENT+="DomainName: \"$SS_ALLOWED_HOSTS\"\n"
YML_CONTENT+="FIAPingURL: \"$FIA_RELEASE_PING_URL\"\n"
YML_CONTENT+="SessionKey: \"$SS_SESSION_KEY\"\n"
YML_CONTENT+="MFASecretKey: \"$SS_MFA_SECRET_KEY\"\n"
YML_CONTENT+="SendAllEmailsTo: \"$SS_SEND_ALL_EMAILS_TO\"\n"
YML_CONTENT+="BYPASS_MFA: \"$BYPASS_MFA\"\n"
YML_CONTENT+="SSAllowSmokeTest: \"$SS_ALLOW_SMOKE_TEST\"\n"
YML_CONTENT+="AdminUser: \"$SS_DEFAULT_ADMIN_USERNAME\"\n"
YML_CONTENT+="AdminPassword: \"$SS_DEFAULT_ADMIN_PASSWORD\"\n"
YML_CONTENT+="\n# Paths\n"
YML_CONTENT+="TEMP_PATH: \"$TEMP_PATH\"\n"
YML_CONTENT+="\n# DB\n"
YML_CONTENT+="# Note: dots in database name have been replaced with underscores\n"

# Write the YAML file
printf "$YML_CONTENT" > "$YMLFILELOCATION"

echo "Created: $YMLFILELOCATION"
echo ""

############################################ BUILD ENV FILE
echo "Building env file: $ENVFILELOCATION"

PHP_CLASS_FILE="${SCRIPT_DIR}/../sunnysideup/env-file-generator/src/EnvFileGenerator.php"

phpCode="require '${PHP_CLASS_FILE}';
\\Sunnysideup\\EnvFileGenerator\\EnvFileGenerator::buildEnvFile('${YMLFILELOCATION}', '${ENVFILELOCATION}', '${ENVFILELOCATION}');"

# The global composer dependencies require a recent PHP, so pick one that is new enough
# (the default `php` may be an older version).
MIN_PHP_VERSION_ID=80401
PHP_BIN=""
for candidate in php php8.5 php8.4; do
    if command -v "$candidate" >/dev/null 2>&1 \
        && "$candidate" -r "exit(PHP_VERSION_ID >= ${MIN_PHP_VERSION_ID} ? 0 : 1);" 2>/dev/null; then
        PHP_BIN="$candidate"
        break
    fi
done

if [ -z "$PHP_BIN" ]; then
    echo "ERROR: PHP 8.4.1 or newer is required (found $(php -r 'echo PHP_VERSION;'))." >&2
    exit 1
fi

echo "Running: $PHP_BIN -r \"$phpCode\""
"$PHP_BIN" -r "$phpCode" || exit 1

echo ""
echonice "Built: $ENVFILELOCATION"
echoend

exit 0