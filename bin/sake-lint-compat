#!/usr/bin/env bash

############################################ BASICS
SCRIPT_DIR="${COMPOSER_RUNTIME_BIN_DIR:?COMPOSER_RUNTIME_BIN_DIR not set}"
WORKING_DIR=$(pwd)
source "$SCRIPT_DIR/sake-self-methods"
SCRIPT_SUMMARY="Checks code compatibility with specified PHP versions using PHPCompatibility"
# composer global require squizlabs/php_codesniffer --dev
# composer global require phpcompatibility/php-compatibility --dev

############################################ DIR
dir='app/src'

############################################ SETTINGS
phpVersion=""          # empty = auto-detect the running PHP version
fallbackVersion="8.2"  # used only if php is not on PATH
help='no'
severity="1,2"
while (($#)); do
    case $1 in
    -p | --php-version)
        phpVersion=$2
        shift
        ;;
    -s | --severity)
        severity=$2
        shift
        ;;
    *)
        if sake_handle_help_flag "$1"; then
            shift
            continue
        fi
        dir=$1
        ;;
    esac
    shift
done

############################################ DETECT PHP VERSION
if [[ -z "$phpVersion" ]]; then
    if command -v php >/dev/null 2>&1; then
        phpVersion=$(php -r 'echo PHP_MAJOR_VERSION . "." . PHP_MINOR_VERSION;')
    else
        phpVersion="$fallbackVersion"
        echonice "php not found on PATH — falling back to PHP $phpVersion"
    fi
fi

############################################ HELP

help_and_exit() {

    ECHOHEAD "Running PHP Compatability"
    echonice "Checks code compatibility with specified PHP versions using PHPCompatibility standard."
    echonice ""
    echonice "directory of script:           $SCRIPT_DIR"
    echonice "directory to analyse:          $WORKING_DIR/$dir"

    ECHOHEAD "Current settings:"
    echonice "PHP Version (-p):              $phpVersion"
    echonice "Severity (-s):                 $severity"

    ECHOHEAD "Available settings:"
    echonice "-p, --php-version              php version, default: current PHP ($phpVersion)"
    echonice "-s, --severity                 what errors? 1 (errors) -> 5 (warnings), default: 1,2"
    echonice "-h, --help                     show help information"

    ECHOHEAD "Example usage:"
    echonice "sake-lint-compat   -p 8.2 -s 1,2   ./app/src"

    echofunctions
    exit
}


sake_check_help_and_exit

############################################ CODE

cd_or_fail "$WORKING_DIR" help_and_exit

$SCRIPT_DIR/phpcs --config-set installed_paths "$SCRIPT_DIR/../phpcompatibility/php-compatibility"
$SCRIPT_DIR/phpcs --config-set colors 1
$SCRIPT_DIR/phpcs --config-set severity $severity
$SCRIPT_DIR/phpcs --config-show

echo "Running PHP Compatability for PHP $phpVersion with severity $severity"
echo "Running command: $SCRIPT_DIR/phpcs -p $dir --standard=PHPCompatibility --extensions=php --runtime-set testVersion $phpVersion"
$SCRIPT_DIR/phpcs -p $dir --standard=PHPCompatibility --extensions=php --runtime-set testVersion $phpVersion



echoend
