#!/usr/bin/env bash

############################################ BASICS
SCRIPT_DIR="${COMPOSER_RUNTIME_BIN_DIR:?COMPOSER_RUNTIME_BIN_DIR not set}"
WORKING_DIR=$(pwd)
source "$SCRIPT_DIR/sake-self-methods"
SCRIPT_SUMMARY="Runs complete security update workflow with tests and composer updates"

############################################ DIR
dir='./'

############################################ BRANCHES
# Branch names used by the decision + finalise logic below.
DEVELOP_BRANCH='develop'
PRODUCTION_BRANCH='production'
HOTFIX_BRANCH='hotfix/security-update'

# Set at runtime by sake_decide_work_branch (a step in the workflow below):
#   develop     -> production and develop are identical; work happens on develop.
#   hotfix/...  -> production is behind; work happens on a hotfix branch cut from
#                  production, so the security release does NOT drag develop's
#                  un-released changes into production.
WORK_BRANCH="$DEVELOP_BRANCH"

############################################ BRANCH DECISION + FINALISE HELPERS
# These are shell functions so they can be called from the STEPS array via eval,
# and (crucially) can set the global WORK_BRANCH that later steps read back.

# Decide which branch the security work happens on.
# Run this AFTER the reverse merge (production -> develop) and BEFORE composer/lint work,
# so the diff reflects only pre-existing (un-released) develop changes.
sake_decide_work_branch() {
    git checkout "$DEVELOP_BRANCH" || return 1

    # Resolve the production ref: prefer local branch, fall back to origin.
    local prod_ref="$PRODUCTION_BRANCH"
    git show-ref --verify --quiet "refs/heads/$PRODUCTION_BRANCH" \
        || prod_ref="origin/$PRODUCTION_BRANCH"

    # "Functionally the same?" -- compare the actual file trees of the two branch
    # tips, ignoring commit history entirely. Merge commits, rebases, cherry-picks,
    # etc. do NOT matter: all we care about is whether the resulting content differs.
    # git diff --quiet exits 0 when the trees are identical, non-zero when they differ.
    if git diff --quiet "$prod_ref" "$DEVELOP_BRANCH"; then
        WORK_BRANCH="$DEVELOP_BRANCH"
        echonice "production and develop are functionally identical."
        echonice "-> working on '$DEVELOP_BRANCH'."
        git checkout "$DEVELOP_BRANCH" || return 1
    else
        local changed
        changed=$(git diff --name-only "$prod_ref" "$DEVELOP_BRANCH" | wc -l)
        WORK_BRANCH="$HOTFIX_BRANCH"
        echonice "production and develop differ ($changed file(s) changed)."
        echonice "-> cutting hotfix branch '$HOTFIX_BRANCH' from '$PRODUCTION_BRANCH'."
        git checkout "$PRODUCTION_BRANCH" || return 1
        if git show-ref --verify --quiet "refs/heads/$HOTFIX_BRANCH"; then
            echonice "   hotfix branch already exists -- checking it out (not recreating)."
            git checkout "$HOTFIX_BRANCH" || return 1
        else
            git checkout -b "$HOTFIX_BRANCH" || return 1
        fi
    fi
    echonice "WORK_BRANCH = $WORK_BRANCH"
}

# Finalise the release. Behaviour depends on the branch we worked on:
#   - hotfix branch : merge hotfix -> production, push production, then reverse
#                     merge production -> develop (same as the start of the run).
#   - develop       : original behaviour -- print the ship reminder, deploy manually.
# Uses WORK_BRANCH, but also treats the currently checked-out branch as the hotfix
# path, so it still does the right thing when resuming via --from/--to.
sake_finalise_release() {
    local current
    current=$(git rev-parse --abbrev-ref HEAD) || return 1

    if [[ "$current" == "$HOTFIX_BRANCH" || "$WORK_BRANCH" == "$HOTFIX_BRANCH" ]]; then
        echonice "Finalising HOTFIX release:"
        echonice "  1. merge '$HOTFIX_BRANCH' -> '$PRODUCTION_BRANCH' (and push)"
        echonice "  2. reverse merge '$PRODUCTION_BRANCH' -> '$DEVELOP_BRANCH'"

        # Merge the hotfix into production.
        # If sake-git-merge-towards-production --ship ships the *current* branch,
        # you can replace the next three git lines with a checkout + --ship instead.
        git checkout "$PRODUCTION_BRANCH" || return 1
        git merge --no-ff "$HOTFIX_BRANCH" \
            -m "MERGE: security update hotfix into production" || return 1
        git push origin "$PRODUCTION_BRANCH" || return 1

        # Bring the security fix back into develop (same op as the start of the run).
        sake-git-merge-towards-production -r || return 1

        # Optional cleanup once you're happy the release is out:
        #   git branch -d "$HOTFIX_BRANCH"
        echonice "Hotfix merged into production and back-merged into develop."
    else
        echonice "production and develop were identical -- standard release from '$DEVELOP_BRANCH'."
        echonice 'Now run:  sake-git-merge-towards-production --ship   to release!'
    fi
}

############################################ STEPS
# Each entry: "Label ::: command"
# Add / remove / reorder steps here -- everything else adapts.
# Internal field separator: ASCII Unit Separator (0x1F).
# Safe because it never appears in labels, commands, or comments.
readonly FS=$'\x1f'

STEPS=()

# add_step <label> <command> [comment]
add_step() {
    STEPS+=("${1}${FS}${2}${FS}${3-}")
}

## CLEAN PROJECT:
add_step \
    'Checkout develop branch' \
    'git checkout develop' \
    ''
add_step \
    'Show git status' \
    'git status' \
    ''
add_step \
    'Quick commit (cleanup)' \
    'sake-git-commit-quick -m "FIX: cleanup"' \
    ''
add_step \
    'Check vendor packages' \
    'sake-git-commit-and-push-vendor-packages . -s "yes"' \
    ''

## REVERSE MERGE:
add_step \
    'Merge production into develop' \
    'sake-git-merge-towards-production -r' \
    ''
add_step \
    'Decide work branch (develop vs hotfix)' \
    'sake_decide_work_branch' \
    'If production == develop -> keep working on develop. If production is behind -> cut hotfix/security-update from production and work there.'
add_step \
    'Check diff from server' \
    'sake-git-prod-diff' \
    'Make sure you have SS_SERVER_FOR_EXAMPLE_DATA set in your .env and that it points to the correct server before running this step!'
add_step \
    'Rsync all - ' \
    'sake-ss-rsync-all' \
    'make sure you have set up your preferred server in your .env SS_SERVER_FOR_EXAMPLE_DATA'
add_step \
    'Dev build (pass 1)' \
    'sake-ss-dev-build' \
    ''
# add_step \
#     'Apply patches (pass 2)' \
#     'bin/apply-patches.sh' \
#     ''
# add_step \
#     'Run tests (pass 2)' \
#     'bin/tests.sh' \
#     ''
add_step \
    'Commit and push!' \
    'sake-git-commit-and-push -m "FIX: update security checker - pre composer"' \
    ''
## COMPOSER UPDATE:
add_step \
    'Composer update (pass 1)' \
    'sake-composer-update' \
    ''

# LINT AND CHECK:
add_step \
    'Commit and push!' \
    'sake-git-commit-and-push -m "FIX: update security checker - post composer"' \
    ''

add_step \
    'Lint app' \
    'sake-lint-all [APP_FOLDERS]' \
    ''
add_step \
    'Lint app' \
    'sake-lint-rector [APP_FOLDERS] -c' \
    ''
add_step \
    'Commit and push!' \
    'sake-git-commit-and-push -m "FIX: update security checker - post lint"' \
    ''

add_step \
    'Lint app' \
    'sake-lint-remove-origs [APP_FOLDERS]' \
    ''
add_step \
    'Check namespaces' \
    'sake-composer-check-namespacing [APP_FOLDERS]' \
    ''
add_step \
    'Dev build (pass 2)' \
    'sake-ss-dev-build' \
    ''
# add_step \
#     'Apply patches (pass 2)' \
#     'bin/apply-patches.sh' \
#     ''
# add_step \
#     'Run tests (pass 2)' \
#     'bin/tests.sh' \
#     ''
add_step \
    'Run Security Checks' \
    'sake-lint-security --all' \
    ''
add_step \
    'Write all Data Objects!' \
    'sudo -u www-data vendor/bin/sake dev/tasks/write-all-data-objects' \
    ''
add_step \
    'Check all end-points' \
    'sudo -u www-data vendor/bin/sake dev/tasks/smoketestcli' \
    'This does not work in SS5, and you will need to run this manually.'

## COMMIT AND PUSH TOWARDS PRODUCTION:
add_step \
    'Commit and push!' \
    'sake-git-commit-and-push -m "FIX: update security checker - final"' \
    ''

## FINALISE:
add_step \
    'Finalise release' \
    'sake_finalise_release' \
    'Hotfix path: merges hotfix -> production (and PUSHES production), then reverse merges production -> develop. Develop path: prints the ship reminder so you can deploy manually. Make sure all checks passed before running this!'

TOTAL_STEPS=${#STEPS[@]}

# --- accessors (same call convention as before: step_label 0, etc.) ---

step_label() {
    local e="${STEPS[$1]}"
    printf '%s' "${e%%"$FS"*}"
}

step_cmd() {
    local e="${STEPS[$1]}"
    e="${e#*"$FS"}"            # drop label
    printf '%s' "${e%%"$FS"*}" # keep up to next FS
}

step_comment() {
    local e="${STEPS[$1]}"
    printf '%s' "${e##*"$FS"}"
}
############################################ SETTINGS
force="no"
list_only="no"
from_step=1
to_step=$TOTAL_STEPS

while (($#)); do
    case $1 in
    -f | --force)
        force="yes"
        ;;
    -l | --list)
        list_only="yes"
        ;;
    --from)
        from_step=$2
        shift
        ;;
    --to)
        to_step=$2
        shift
        ;;
    -o | --only | --step)
        from_step=$2
        to_step=$2
        shift
        ;;
    *)
        if sake_handle_help_flag "$1"; then
            shift
            continue
        fi
        dir=$1
        ;;
    esac
    shift
done

############################################ APP FOLDERS
# Level-1 folders under $dir that:
#   - are not _dev, vendor, bin, or themes
#   - do not contain a _manifest_exclude file
# Safely fetch app folders for the given directory
APP_FOLDERS=()
mapfile -t APP_FOLDERS < <(silverstripe_php_folders "$dir")

help_and_exit() {

    ECHOHEAD "Run the SilverStripe security update workflow"
    echonice "$SCRIPT_SUMMARY"
    echonice ""
    echonice "Runs complete security update workflow including composer updates and testing"
    echonice ""
    echonice "Directory of script:          $SCRIPT_DIR"
    echonice "Directory to analyse:         $WORKING_DIR/$dir"
    echonice "Total steps:                  $TOTAL_STEPS"
    echonice "App folders detected:         ${APP_FOLDERS[*]:-(none)}"

    ECHOHEAD "Available settings:"
    echonice "-f, --force                   run all steps without prompts"
    echonice "-l, --list                    list all steps and exit"
    echonice "    --from N                  start from step N (1..$TOTAL_STEPS)"
    echonice "    --to N                    stop after step N"
    echonice "-o, --only N                  run only step N (alias: --step N)"
    echonice "-h, --help                    display this help message and exit"

    ECHOHEAD "Per-step controls:"
    echonice "Before each step you'll be prompted with:"
    echonice "    [O]K           run the step"
    echonice "    [S]kip         skip and move on"
    echonice "    [Q]uit         exit the script"
    echonice "After each step you'll be prompted with:"
    echonice "    [O]K           continue to next step"
    echonice "    [R]un again    run this step again"
    echonice "    [C]ontinue     (only if the step failed) continue anyway"
    echonice "    [Q]uit         exit the script"

    ECHOHEAD "Example usage:"
    echonice "sake-ss-security-update ./"
    echonice "sake-ss-security-update ./ -f"
    echonice "sake-ss-security-update --list"
    echonice "sake-ss-security-update --from 5"
    echonice "sake-ss-security-update --from 3 --to 7"
    echonice "sake-ss-security-update --only 6"
    exit 1
}

declare -A BRANCH_RESULTS

sake_check_help_and_exit

############################################ LIST STEPS (--list)
if [[ "$list_only" == "yes" ]]; then
    ECHOHEAD "All steps in this workflow:"
    for ((i = 0; i < TOTAL_STEPS; i++)); do
        n=$((i + 1))
        echonice "$(printf '%2d' "$n"). $(step_label "$i")"
        echonice "     \$ $(step_cmd "$i")"
    done
    exit 0
fi

############################################ VALIDATE RANGE
if ! [[ "$from_step" =~ ^[0-9]+$ ]] || ((from_step < 1 || from_step > TOTAL_STEPS)); then
    echo "Invalid --from value: '$from_step' (must be 1..$TOTAL_STEPS)" >&2
    exit 1
fi
if ! [[ "$to_step" =~ ^[0-9]+$ ]] || ((to_step < from_step || to_step > TOTAL_STEPS)); then
    echo "Invalid --to value: '$to_step' (must be $from_step..$TOTAL_STEPS)" >&2
    exit 1
fi

############################################ HELPERS
# prompt_choice "<prompt>" "<default-letter>" "<valid letters separated by |>"
prompt_choice() {
    local prompt="$1"
    local default="$2"
    local valid="$3"
    local reply
    while true; do
        read -rp "$prompt " reply
        reply="${reply,,}"
        [[ -z "$reply" ]] && reply="$default"
        if [[ "|$valid|" == *"|$reply|"* ]]; then
            echo "$reply"
            return
        fi
        echo "Please answer one of: $valid" >&2
    done
}

# Runs a command. If it contains [APP_FOLDERS], runs it once per app folder
# with the placeholder replaced by each folder name. Returns non-zero if any
# invocation failed (keeps the last failing exit code).
run_step_cmd() {
    local cmd="$1"

    if [[ "$cmd" != *'[APP_FOLDERS]'* ]]; then
        eval "$cmd"
        return $?
    fi

    if ((${#APP_FOLDERS[@]} == 0)); then
        echonice "No app folders found for [APP_FOLDERS] -- nothing to run."
        return 0
    fi

    local folder expanded rc=0 this_rc
    for folder in "${APP_FOLDERS[@]}"; do
        expanded="${cmd//\[APP_FOLDERS\]/$folder}"
        echonice "-> $expanded"
        eval "$expanded"
        this_rc=$?
        ((this_rc != 0)) && rc=$this_rc
    done
    return $rc
}

############################################ RUN STEPS
ECHOHEAD "Running steps $from_step..$to_step of $TOTAL_STEPS"
for ((i = from_step - 1; i < to_step; i++)); do
    step_num=$((i + 1))
    label="$(step_label "$i")"
    cmd="$(step_cmd "$i")"
    comment="$(step_comment "$i")"

    ECHOHEAD "Step $step_num/$TOTAL_STEPS: $label"
    echonice "Command: $cmd"
    echonice "Comment: $comment"

    # Decide whether to run this step at all.
    if [[ "$force" != "yes" ]]; then
        action=$(prompt_choice "[O]K / [S]kip / [Q]uit (default O):" "o" "o|s|q")
        case "$action" in
        s)
            echonice "-> Skipped step $step_num."
            continue
            ;;
        q)
            echonice "-> Quit at step $step_num."
            exit 0
            ;;
        esac
    fi

    # Run (and optionally re-run) the command.
    while true; do
        run_step_cmd "$cmd"
        rc=$?
        echo
        if ((rc == 0)); then
            echonice "OK  Step $step_num completed."
        else
            echonice "ERR Step $step_num failed (exit $rc)."
        fi
        echonice "-> $cmd"
        echonice "-> $comment"
        echoline

        if [[ "$force" == "yes" ]]; then
            if ((rc != 0)); then
                echonice "-> Stopping (force mode + non-zero exit)."
                exit "$rc"
            fi
            break
        fi

        # Show the upcoming step (if any) before asking whether to continue.
        if ((i + 1 < to_step)); then
            echonice "Next: step $((i + 2))/$TOTAL_STEPS: $(step_label "$((i + 1))")"
            echonice "      \$ $(step_cmd "$((i + 1))")"
        else
            echonice "Next: (this is the last step in the range)"
        fi

        if ((rc == 0)); then
            after=$(prompt_choice "[O]K continue / [R]un again / [Q]uit (default O):" "o" "o|r|q")
        else
            after=$(prompt_choice "[R]un again / [C]ontinue anyway / [Q]uit (default Q):" "q" "r|c|q")
        fi
        case "$after" in
        r) continue ;; # re-runs the command directly now
        q) exit "$rc" ;;
        o | c) break ;;
        esac
    done
done

echoend