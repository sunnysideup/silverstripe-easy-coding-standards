#!/usr/bin/env bash

############################################ BASICS
SCRIPT_DIR="${COMPOSER_RUNTIME_BIN_DIR:?COMPOSER_RUNTIME_BIN_DIR not set}"
WORKING_DIR=$(pwd)
source "$SCRIPT_DIR/sake-self-methods"
SCRIPT_SUMMARY="Net diff per GitHub repo (public + private) for the last X days"

############################################ HELPERS
#
# HOW REPOS ARE FOUND:
#   * GitHub's /user/repos endpoint with affiliation=owner,collaborator,
#     organization_member: EVERY repo you can access — your own, every org you
#     belong to, and repos you collaborate on. (`gh repo list` only returns ONE
#     owner's repos, which silently missed org repos.)
#   * Kept only if pushed within the window. -u restricts to given owners.
#
# HOW THE DIFF IS BUILT (read before changing the git lines):
#   * Each repo is kept as a BLOBLESS BARE clone in the cache dir: full commit
#     history, file contents only downloaded when a diff needs them.
#   * Per branch, the diff runs from the last commit BEFORE the cutoff
#     (--first-parent, committer date) to the current tip — the NET change
#     over the period, not one patch per commit.
#   * No commit before the cutoff: the default branch is diffed against git's
#     empty tree (new repo); any other branch against its merge-base with the
#     default branch (new feature branch → only its own changes).
#   * Every repo that was pushed but produced no diff is listed in the summary
#     with the reason, so nothing disappears silently.
#   * Everything runs locally; no value ever passes through a remote shell, so
#     plain double quotes are enough everywhere.

# git with gh's token for HTTPS, without touching the global git config.
gh_git() {
    git -c credential.helper= -c 'credential.helper=!gh auth git-credential' "$@"
}

# Clone (first run) or fetch (later runs) a blobless bare copy of a repo.
sync_repo_cache() {
    local repo="$1" dir="$2"
    if [[ -d "$dir" ]]; then
        gh_git -C "$dir" fetch --quiet --prune origin '+refs/heads/*:refs/heads/*'
    else
        gh_git clone --quiet --bare --filter=blob:none "https://github.com/$repo.git" "$dir"
    fi
}

# Print one branch section (header, --stat, full diff) to stdout.
write_branch_section() {
    local dir="$1" repo="$2" branch="$3" base="$4" tip="$5" commits="$6"
    printf '# Repo:    %s\n' "$repo"
    printf '# Branch:  %s\n' "$branch"
    printf '# Range:   %s..%s\n' "${base:0:12}" "${tip:0:12}"
    printf '# Commits: %s since %s\n#\n' "$commits" "$since"
    git -C "$dir" diff --no-ext-diff --no-color --find-renames --stat=120 "$base" "$tip" | sed 's/^/# /'
    echo
    git -C "$dir" diff --no-ext-diff --no-color --find-renames "$base" "$tip"
    printf '\n'
}

############################################ SETTINGS
days=2
owners=''
outDir=''
cacheDir="${XDG_CACHE_HOME:-$HOME/.cache}/sake-git-diff-recent"
noForks='no'
allBranches='no'
help='no'

while (($#)); do
    case $1 in
    -h | --help)
        help='yes'
        ;;
    -d | --days)
        days=$2
        shift
        ;;
    -u | --owner)
        owners=$2
        shift
        ;;
    -o | --out)
        outDir=$2
        shift
        ;;
    -c | --cache)
        cacheDir=$2
        shift
        ;;
    -a | --all-branches)
        allBranches='yes'
        ;;
    --no-forks)
        noForks='yes'
        ;;
    *)
        if sake_handle_help_flag "$1"; then
            shift
            continue
        fi
        if [[ "$1" == -* ]]; then
            echobad "Unknown option: $1 (run with -h for help)"
            exit 1
        fi
        # Positional argument = number of days
        days=$1
        ;;
    esac

    shift
done

outDir="${outDir:-$WORKING_DIR/repo-diffs-$(date +%Y%m%d-%H%M%S)}"

if [[ "$help" == "yes" ]]; then
    ECHOHEAD "Diff Recent Repos"
    echonice "Writes ONE net diff per GitHub repo (public + private) covering"
    echonice "everything that changed in the last X days."
    echonice ""
    echonice "Directory of script:           $SCRIPT_DIR"
    echonice "Number of days:                $days"
    echonice "Owners:                        ${owners:-<all repos you can access>}"
    echonice "All branches:                  $allBranches"
    echonice "Exclude forks:                 $noForks"
    echonice "Output dir:                    $outDir"
    echonice "Cache dir (bare clones):       $cacheDir"

    echonice ""
    ECHOHEAD "Available settings:"
    echonice "DAYS                           number of days to look back (positional, default 2)"
    echonice "-d, --days DAYS                same as the positional DAYS"
    echonice "-u, --owner OWNER[,OWNER]      only these users / orgs (default: all you can access)"
    echonice "-a, --all-branches             include every branch, not just the default branch"
    echonice "    --no-forks                 skip forked repos"
    echonice "-o, --out DIR                  where to write the .diff files"
    echonice "-c, --cache DIR                where the bare clones are cached"
    echonice "-q, --quiet                    no progress output (only the output dir on stdout)"
    echonice "-h, --help                     show help information"
    echonice ""
    ECHOHEAD "Which repos:"
    echonice "Every repo your gh login can access: your own, every org you belong to,"
    echonice "      and repos you collaborate on, filtered to those pushed in the window."
    echonice "      Private org repos need the gh token to have 'read:org' and, for orgs"
    echonice "      with SSO, the token must be authorised for that org."
    echonice ""
    ECHOHEAD "Output:"
    echonice "One <owner>__<repo>.diff per changed repo (one section per branch with -a),"
    echonice "      each starting with a --stat summary, plus ALL-REPOS.diff."
    echonice "      The output dir path is printed on stdout, so you can pipe it."
    echonice "      Repos that were pushed but gave no diff are listed with the reason."
    echonice ""
    ECHOHEAD "Examples:"
    echonice "sake-git-diff-recent                    # last 2 days, all your repos"
    echonice "sake-git-diff-recent 7 -a               # last 7 days, every branch"
    echonice "sake-git-diff-recent 3 -u my-org,me     # only these owners"
    echonice "sake-git-diff-recent 2 -o ~/diffs --no-forks"
    echonice "less \"\$(sake-git-diff-recent -q 1)/ALL-REPOS.diff\""
    echofunctions
    exit
fi

sake_check_help_and_exit

############################################ CHECKS
if [[ ! "$days" =~ ^[1-9][0-9]*$ ]]; then
    echobad "Number of days must be a positive whole number (got '$days')."
    exit 1
fi

for cmd in git gh jq; do
    if ! command -v "$cmd" &>/dev/null; then
        echobad "'$cmd' is not installed."
        echonice "Install it with: sudo apt install $cmd"
        exit 1
    fi
done

check_gh_auth
if ! gh auth status &>/dev/null; then
    echobad "GitHub CLI is still not logged in — cannot list private repos."
    exit 1
fi

############################################ FIND REPOS
since=$(date -u -d "$days days ago" +%Y-%m-%dT%H:%M:%SZ)
emptyTree=$(git hash-object -t tree /dev/null)

mkdir -p "$outDir" "$cacheDir" || {
    echobad "Could not create output or cache dir."
    exit 1
}

repoListFile=$(mktemp)
trap 'rm -f "$repoListFile"' EXIT

ECHOHEAD "Repos changed since $since ($days day(s))"
echonice "Owners:       ${owners:-<all repos you can access>}"
echonice "All branches: $allBranches"
echonice "Output:       $outDir"
echonice "Cache:        $cacheDir"
echoline
echonice "Listing every repo your GitHub login can access..."

gh api --paginate \
    "user/repos?affiliation=owner,collaborator,organization_member&sort=pushed&per_page=100" \
    >"$repoListFile" || {
    echobad "Could not list repos from GitHub."
    exit 1
}

# --paginate prints one JSON array per page; jq handles the stream of arrays.
totalRepos=$(jq -s 'map(length) | add // 0' "$repoListFile")

mapfile -t repos < <(
    jq -r --arg since "$since" --arg noForks "$noForks" --arg owners "${owners,,}" '
        .[]
        | select(.pushed_at != null and .pushed_at >= $since)
        | select($noForks != "yes" or (.fork | not))
        | select($owners == "" or (
            (.owner.login | ascii_downcase) as $o
            | $owners | split(",") | map(gsub("^\\s+|\\s+$"; "")) | any(. == $o)
          ))
        | "\(.full_name)\t\(.default_branch)"' "$repoListFile"
)

echonice "Accessible repos: $totalRepos — pushed in the window: ${#repos[@]}"

if ((${#repos[@]} == 0)); then
    echonice "No repos pushed in the last $days day(s)."
    rmdir "$outDir" 2>/dev/null
    echoend
    exit 0
fi

############################################ DIFF EACH REPO
written=()
failed=()
emptyRepos=()
otherBranchesOnly=()
noRecentCommits=()

for line in "${repos[@]}"; do
    IFS=$'\t' read -r repo defaultBranch <<<"$line"
    slug="${repo//\//__}"
    dir="$cacheDir/$slug.git"
    outFile="$outDir/$slug.diff"

    if ! sync_repo_cache "$repo" "$dir"; then
        echobad "$repo: clone / fetch failed."
        failed+=("$repo")
        continue
    fi

    if ! defaultTip=$(git -C "$dir" rev-parse --verify -q "refs/heads/$defaultBranch^{commit}"); then
        emptyRepos+=("$repo")
        continue
    fi

    # Default branch first, then (with -a) every other branch.
    branches=("$defaultBranch")
    if [[ "$allBranches" == "yes" ]]; then
        while IFS= read -r b; do
            [[ "$b" != "$defaultBranch" ]] && branches+=("$b")
        done < <(git -C "$dir" for-each-ref --format='%(refname:short)' refs/heads)
    fi

    : >"$outFile"
    summaryParts=()

    for branch in "${branches[@]}"; do
        tip=$(git -C "$dir" rev-parse --verify -q "refs/heads/$branch^{commit}") || continue

        # State of this branch at the cutoff.
        base=$(git -C "$dir" rev-list -1 --first-parent --before="$since" "$tip")

        if [[ -z "$base" ]]; then
            if [[ "$branch" != "$defaultBranch" ]]; then
                # New feature branch: only its own changes, relative to the default branch.
                base=$(git -C "$dir" merge-base "$tip" "$defaultTip" || true)
            fi
            if [[ -z "$base" ]]; then
                # New repo (or unrelated history): everything shows as added.
                base="$emptyTree"
                commits=$(git -C "$dir" rev-list --count --first-parent "$tip")
            else
                commits=$(git -C "$dir" rev-list --count "$base..$tip")
            fi
        else
            commits=$(git -C "$dir" rev-list --count --first-parent "$base..$tip")
        fi

        # No new commits on this branch in the window.
        [[ "$base" == "$tip" || "$commits" == "0" ]] && continue

        if ! write_branch_section "$dir" "$repo" "$branch" "$base" "$tip" "$commits" >>"$outFile"; then
            echobad "$repo ($branch): writing the diff failed."
            failed+=("$repo ($branch)")
            continue
        fi
        summaryParts+=("$branch: $commits")
    done

    if ((${#summaryParts[@]} > 0)); then
        written+=("$outFile")
        echonice "$repo — $(IFS=,; echo "${summaryParts[*]}" | sed 's/,/, /g') commit(s)"
        continue
    fi

    # Pushed, but nothing to diff: record WHY so it is visible in the summary.
    rm -f "$outFile"
    if [[ -n "$(git -C "$dir" rev-list -1 --since="$since" --branches)" ]]; then
        otherBranchesOnly+=("$repo")
    else
        noRecentCommits+=("$repo")
    fi
done

############################################ SUMMARY
ECHOHEAD "Summary"
echonice "Accessible repos:          $totalRepos"
echonice "Pushed in the window:      ${#repos[@]}"
echonice "Repos with a diff:         ${#written[@]}"

if ((${#otherBranchesOnly[@]} > 0)); then
    echowarn "Changed ONLY on non-default branches (${#otherBranchesOnly[@]}) — rerun with -a / --all-branches to include them:"
    printf '   %s\n' "${otherBranchesOnly[@]}" >&2
fi
if ((${#noRecentCommits[@]} > 0)); then
    echowarn "Pushed, but no commits DATED in the window (${#noRecentCommits[@]}) — tags, branch deletes, or older commits pushed late:"
    printf '   %s\n' "${noRecentCommits[@]}" >&2
fi
if ((${#emptyRepos[@]} > 0)); then
    echowarn "Empty repos / default branch missing (${#emptyRepos[@]}):"
    printf '   %s\n' "${emptyRepos[@]}" >&2
fi
if ((${#failed[@]} > 0)); then
    echowarn "Failed (${#failed[@]}):"
    printf '   %s\n' "${failed[@]}" >&2
fi

if ((${#written[@]} == 0)); then
    echonice "No diffs to write."
    rmdir "$outDir" 2>/dev/null
    echoend
    exit 0
fi

# One file with everything, in addition to the per-repo files.
for f in "${written[@]}"; do
    cat "$f"
    printf '\n'
done >"$outDir/ALL-REPOS.diff"

echonice "Per-repo diffs:       $outDir/<owner>__<repo>.diff"
echonice "Everything combined:  $outDir/ALL-REPOS.diff"

# Pure data output: the output dir, so the script can be piped.
printf '%s\n' "$outDir"

echoend
