#!/usr/bin/env bash
set -euo pipefail

############################################ BASICS
SCRIPT_DIR="${COMPOSER_RUNTIME_BIN_DIR:?COMPOSER_RUNTIME_BIN_DIR not set}"
WORKING_DIR=$(pwd)
source "$SCRIPT_DIR/sake-self-methods"
SCRIPT_SUMMARY="Manages collaborators on GitHub repositories (add, remove, list)"

############################################ EARLY HELPERS
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'Warning: %s\n' "$*" >&2; }

############################################ SETTINGS
FILTER='*'
DRY_RUN=false
INCLUDE_ARCHIVED=false
AFFILIATION=all
ASSUME_YES=false

# Collect positional args here; route help flags through the sake helper.
args=()
while (($#)); do
    case $1 in
    --filter)
        (($# >= 2)) || die "--filter needs a value, e.g. --filter 'silverstripe-*'"
        FILTER=$2
        shift
        ;;
    --filter=*)
        FILTER=${1#*=}
        ;;
    --dry-run)
        DRY_RUN=true
        ;;
    --include-archived)
        INCLUDE_ARCHIVED=true
        ;;
    --direct)
        AFFILIATION=direct
        ;;
    -y | --yes)
        ASSUME_YES=true
        ;;
    *)
        if sake_handle_help_flag "$1"; then
            shift
            continue
        fi
        args+=("$1")
        ;;
    esac
    shift
done
set -- "${args[@]}"

############################################ HELP

help_and_exit() {
    ECHOHEAD "Git add collaborator"
    echonice "Adds, removes and lists collaborators on GitHub repositories"
    echonice ""
    echonice "directory of script:           $SCRIPT_DIR"

    ECHOHEAD "Commands:"
    echonice "add owner/repo username [perm]     add user to one repo (default command)"
    echonice "add-all owner username [perm]      add user to ALL repos of owner"
    echonice "remove owner/repo username         remove user (and pending invite) from one repo"
    echonice "remove-all owner username          remove user (and pending invites) from ALL repos"
    echonice "user-access owner username         list the repos of owner this user can access"
    echonice "repo-users owner[/repo]            list collaborators per repo (one or all)"

    ECHOHEAD "Available settings:"
    echonice "-h, --help                         show help information"
    echonice "--filter 'pattern'                 only repos whose name matches glob, e.g. 'silverstripe-*'"
    echonice "--include-archived                 include archived repos (skipped by default)"
    echonice "--direct                           repo-users: only direct collaborators (no org/team access)"
    echonice "--dry-run                          add-all / remove-all / add / remove: show, do not change"
    echonice "-y, --yes                          do not ask for confirmation on bulk changes"

    ECHOHEAD "permission                         use one of:"
    echonice "                                   push (default!)"
    echonice "                                   pull"
    echonice "                                   triage"
    echonice "                                   maintain"
    echonice "                                   admin"
    echonice "Token                              set GITHUB_TOKEN env var,"
    echonice "                                   or place it in ~/.github_token"

    ECHOHEAD "Example usage:"
    echonice "sake-git-add-collaborator my-org/silverstripe-mymodule octocat"
    echonice "sake-git-add-collaborator add-all my-org octocat maintain --filter 'silverstripe-*'"
    echonice "sake-git-add-collaborator remove-all my-org octocat --dry-run"
    echonice "sake-git-add-collaborator user-access my-org octocat"
    echonice "sake-git-add-collaborator repo-users my-org --direct"
    echonice "sake-git-add-collaborator repo-users my-org/silverstripe-mymodule"

    echofunctions
    exit
}

sake_check_help_and_exit

############################################ CODE

# --- Configuration ---------------------------------------------------------

API="https://api.github.com"
API_STATUS=""
API_BODY=""
AUTH_LOGIN=""
REPOS=()

REPO_RE='^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$'
NAME_RE='^[A-Za-z0-9-]+$'

# --- Validation ------------------------------------------------------------

valid_repo() {
    [[ $1 =~ $REPO_RE ]] || die "Repository must be in 'owner/repo' format (got: '$1')."
}

valid_name() {
    [[ $1 =~ $NAME_RE ]] || die "Invalid $2 '$1'."
}

valid_perm() {
    case $1 in
    pull | triage | push | maintain | admin) ;;
    *) die "Invalid permission '$1'. Use: pull, triage, push, maintain, or admin." ;;
    esac
}

# --- API helpers -----------------------------------------------------------

# Extract GitHub's error message from a JSON body (empty if none).
gh_msg() {
    jq -r '.message? // empty' <<<"$1" 2>/dev/null || true
}

# api METHOD PATH [JSON_DATA] -> sets API_STATUS and API_BODY
api() {
    local method=$1 path=$2 data=${3:-} response
    local -a opts=(
        -sS -w '\n%{http_code}' -X "$method"
        -H "Accept: application/vnd.github+json"
        -H "Authorization: Bearer $TOKEN"
        -H "X-GitHub-Api-Version: 2022-11-28"
    )
    if [[ -n $data ]]; then
        opts+=(-d "$data")
    fi
    response=$(curl "${opts[@]}" "$API$path") || die "Network error calling $method $path"
    API_STATUS=${response##*$'\n'}
    API_BODY=${response%$'\n'*}
}

# api_get_all PATH -> prints one merged JSON array of all pages; returns 1 on error
api_get_all() {
    local path=$1 sep='?' page=1 count all='[]'
    if [[ $path == *\?* ]]; then
        sep='&'
    fi
    while true; do
        api GET "${path}${sep}per_page=100&page=${page}"
        if [[ $API_STATUS != 200 ]]; then
            warn "GET $path failed (HTTP $API_STATUS): $(gh_msg "$API_BODY")"
            return 1
        fi
        count=$(jq 'length' <<<"$API_BODY")
        if ((count == 0)); then
            break
        fi
        all=$(jq -s 'add' <<<"$all $API_BODY")
        if ((count < 100)); then
            break
        fi
        page=$((page + 1))
    done
    printf '%s\n' "$all"
}

# --- Repository discovery --------------------------------------------------

# get_repos OWNER -> prints matching full repo names, one per line
get_repos() {
    local owner=$1 path type json name archived
    api GET "/users/$owner"
    [[ $API_STATUS == 200 ]] || die "Owner '$owner' not found (HTTP $API_STATUS)."
    type=$(jq -r '.type' <<<"$API_BODY")

    if [[ $type == Organization ]]; then
        path="/orgs/$owner/repos?type=all"
    elif [[ ${owner,,} == "${AUTH_LOGIN,,}" ]]; then
        # Your own account: this endpoint also returns private repos.
        path="/user/repos?affiliation=owner"
    else
        path="/users/$owner/repos?type=owner"
    fi

    json=$(api_get_all "$path") || die "Could not list repositories for '$owner'."

    while IFS=$'\t' read -r name archived; do
        [[ -n $name ]] || continue
        if [[ $archived == true && $INCLUDE_ARCHIVED != true ]]; then
            continue
        fi
        # Unquoted on purpose: FILTER is a glob pattern.
        # shellcheck disable=SC2053
        [[ ${name#*/} == $FILTER ]] || continue
        printf '%s\n' "$name"
    done < <(jq -r 'sort_by(.full_name) | .[] | [.full_name, .archived] | @tsv' <<<"$json")
}

# load_repos OWNER -> fills REPOS array
load_repos() {
    local owner=$1 list
    list=$(get_repos "$owner")
    REPOS=()
    if [[ -n $list ]]; then
        mapfile -t REPOS <<<"$list"
    fi
    ((${#REPOS[@]} > 0)) || die "No repositories found for '$owner' matching '$FILTER'."
    echonice "Found ${#REPOS[@]} repositories for '$owner' (filter: '$FILTER')."
}

confirm() {
    if [[ $ASSUME_YES == true || $DRY_RUN == true ]]; then
        return 0
    fi
    local reply
    read -r -p "$1 [y/N] " reply </dev/tty || return 1
    [[ $reply =~ ^[Yy]([Ee][Ss])?$ ]]
}

# --- Actions ---------------------------------------------------------------

# add_one REPO USER PERMISSION
add_one() {
    local repo=$1 user=$2 perm=$3
    if [[ $DRY_RUN == true ]]; then
        echonice "[dry-run] $repo: would add '$user' with '$perm' permission."
        return 0
    fi
    api PUT "/repos/$repo/collaborators/$user" "{\"permission\":\"$perm\"}"
    case $API_STATUS in
    201)
        echonice "$repo: invitation sent. '$user' must accept it to become a collaborator."
        ;;
    204)
        echonice "$repo: '$user' already has access; permission set to '$perm'."
        ;;
    403)
        warn "$repo: forbidden (403). Your token may lack admin rights on this repo. $(gh_msg "$API_BODY")"
        return 1
        ;;
    404)
        warn "$repo: not found (404). Check the repo name, the username, and token access. $(gh_msg "$API_BODY")"
        return 1
        ;;
    422)
        warn "$repo: unprocessable (422). The username may be invalid or already invited. $(gh_msg "$API_BODY")"
        return 1
        ;;
    *)
        warn "$repo: unexpected response (HTTP $API_STATUS): $(gh_msg "$API_BODY")"
        return 1
        ;;
    esac
}

# remove_one REPO USER -> removes direct collaborator and cancels pending invitations
remove_one() {
    local repo=$1 user=$2 json id removed=false
    local -a ids=()

    # 1. Direct collaborator?
    json=$(api_get_all "/repos/$repo/collaborators?affiliation=direct") || return 1
    if jq -e --arg u "${user,,}" 'any(.[]; (.login | ascii_downcase) == $u)' <<<"$json" >/dev/null; then
        if [[ $DRY_RUN == true ]]; then
            echonice "[dry-run] $repo: would remove collaborator '$user'."
        else
            api DELETE "/repos/$repo/collaborators/$user"
            if [[ $API_STATUS == 204 ]]; then
                echonice "$repo: removed collaborator '$user'."
            else
                warn "$repo: could not remove '$user' (HTTP $API_STATUS): $(gh_msg "$API_BODY")"
                return 1
            fi
        fi
        removed=true
    fi

    # 2. Pending invitations
    json=$(api_get_all "/repos/$repo/invitations") || return 1
    mapfile -t ids < <(jq -r --arg u "${user,,}" \
        '.[] | select((.invitee.login // "" | ascii_downcase) == $u) | .id' <<<"$json")
    for id in "${ids[@]}"; do
        [[ -n $id ]] || continue
        if [[ $DRY_RUN == true ]]; then
            echonice "[dry-run] $repo: would cancel pending invitation #$id for '$user'."
        else
            api DELETE "/repos/$repo/invitations/$id"
            if [[ $API_STATUS == 204 ]]; then
                echonice "$repo: cancelled pending invitation for '$user'."
            else
                warn "$repo: could not cancel invitation #$id (HTTP $API_STATUS): $(gh_msg "$API_BODY")"
                return 1
            fi
        fi
        removed=true
    done

    if [[ $removed == false ]]; then
        api GET "/repos/$repo/collaborators/$user"
        if [[ $API_STATUS == 204 ]]; then
            echonice "$repo: '$user' has access via organisation membership or a team - not removed here."
        else
            echonice "$repo: '$user' has no access - skipped."
        fi
    fi
}

# run_bulk FUNCTION USER [PERMISSION] -> runs FUNCTION for every repo in REPOS
run_bulk() {
    local action=$1 user=$2 perm=${3:-} ok=0 failed=0 repo
    for repo in "${REPOS[@]}"; do
        if "$action" "$repo" "$user" "$perm"; then
            ok=$((ok + 1))
        else
            failed=$((failed + 1))
        fi
        # GitHub asks for ~1s between mutating requests to avoid secondary rate limits.
        if [[ $DRY_RUN != true ]]; then
            sleep 1
        fi
    done
    ECHOHEAD "Summary"
    echonice "Succeeded: $ok   Failed: $failed"
    ((failed == 0))
}

# user_access OWNER USER -> lists repos (and roles) the user can access
user_access() {
    local owner=$1 user=$2 repo role json invited found=0
    load_repos "$owner"
    ECHOHEAD "Access for '$user' on '$owner'"
    for repo in "${REPOS[@]}"; do
        api GET "/repos/$repo/collaborators/$user"
        case $API_STATUS in
        204)
            api GET "/repos/$repo/collaborators/$user/permission"
            role=$(jq -r '.role_name // .permission // "unknown"' <<<"$API_BODY")
            printf '  %-55s %s\n' "$repo" "$role"
            found=$((found + 1))
            ;;
        404)
            if json=$(api_get_all "/repos/$repo/invitations" 2>/dev/null); then
                invited=$(jq -r --arg u "${user,,}" \
                    'first(.[] | select((.invitee.login // "" | ascii_downcase) == $u) | .permissions) // empty' \
                    <<<"$json")
                if [[ -n $invited ]]; then
                    printf '  %-55s %s (invitation pending)\n' "$repo" "$invited"
                    found=$((found + 1))
                fi
            fi
            ;;
        *)
            warn "$repo: could not check access (HTTP $API_STATUS): $(gh_msg "$API_BODY")"
            ;;
        esac
    done
    echonice ""
    echonice "'$user' has access to $found of ${#REPOS[@]} repositories."
}

# repo_users OWNER | OWNER/REPO -> lists collaborators per repo
repo_users() {
    local target=$1 repo json login role
    if [[ $target == */* ]]; then
        REPOS=("$target")
    else
        load_repos "$target"
    fi

    for repo in "${REPOS[@]}"; do
        ECHOHEAD "$repo"
        if ! json=$(api_get_all "/repos/$repo/collaborators?affiliation=$AFFILIATION"); then
            continue
        fi
        if [[ $(jq 'length' <<<"$json") == 0 ]]; then
            echonice "  (no collaborators)"
        else
            while IFS=$'\t' read -r login role; do
                printf '  %-30s %s\n' "$login" "$role"
            done < <(jq -r '.[] | [.login, (.role_name // "-")] | @tsv' <<<"$json")
        fi

        # Pending invitations (needs admin rights; silently skipped otherwise).
        if json=$(api_get_all "/repos/$repo/invitations" 2>/dev/null); then
            while IFS=$'\t' read -r login role; do
                [[ -n $login ]] || continue
                printf '  %-30s %s (invitation pending)\n' "$login" "$role"
            done < <(jq -r '.[] | [(.invitee.login // "(email invite)"), .permissions] | @tsv' <<<"$json")
        fi
    done
}

# --- Parse arguments -------------------------------------------------------

COMMAND=add
case ${1:-} in
add | add-all | remove | remove-all | user-access | repo-users)
    COMMAND=$1
    shift
    ;;
esac

PERMISSION=push
case $COMMAND in
add)
    (($# >= 2 && $# <= 3)) || help_and_exit
    valid_repo "$1"
    valid_name "$2" "username"
    PERMISSION=${3:-push}
    valid_perm "$PERMISSION"
    ;;
add-all)
    (($# >= 2 && $# <= 3)) || help_and_exit
    valid_name "$1" "owner"
    valid_name "$2" "username"
    PERMISSION=${3:-push}
    valid_perm "$PERMISSION"
    ;;
remove)
    (($# == 2)) || help_and_exit
    valid_repo "$1"
    valid_name "$2" "username"
    ;;
remove-all | user-access)
    (($# == 2)) || help_and_exit
    valid_name "$1" "owner"
    valid_name "$2" "username"
    ;;
repo-users)
    (($# == 1)) || help_and_exit
    if [[ $1 == */* ]]; then
        valid_repo "$1"
    else
        valid_name "$1" "owner"
    fi
    ;;
esac

# --- Requirements & token --------------------------------------------------

command -v curl >/dev/null 2>&1 || die "curl is required but not installed (sudo apt install curl)."
command -v jq >/dev/null 2>&1 || die "jq is required but not installed (sudo apt install jq)."

# Prefer the env var, fall back to ~/.github_token (matches the help text).
TOKEN="${GITHUB_TOKEN:-}"
if [[ -z "$TOKEN" && -r "$HOME/.github_token" ]]; then
    TOKEN="$(tr -d '[:space:]' <"$HOME/.github_token")"
fi
[[ -n "$TOKEN" ]] || die "No token found. Set GITHUB_TOKEN or create ~/.github_token."

api GET /user
[[ $API_STATUS == 200 ]] || die "Token rejected by GitHub (HTTP $API_STATUS): $(gh_msg "$API_BODY")"
AUTH_LOGIN=$(jq -r '.login' <<<"$API_BODY")
echonice "Authenticated as '$AUTH_LOGIN'."

# --- Run -------------------------------------------------------------------

STATUS=0
case $COMMAND in
add)
    echonice "Adding '$2' to '$1' with '$PERMISSION' permission..."
    add_one "$1" "$2" "$PERMISSION" || STATUS=1
    ;;
add-all)
    load_repos "$1"
    printf '  %s\n' "${REPOS[@]}"
    confirm "Add '$2' with '$PERMISSION' permission to these ${#REPOS[@]} repositories?" || die "Aborted."
    run_bulk add_one "$2" "$PERMISSION" || STATUS=1
    ;;
remove)
    echonice "Removing '$2' from '$1'..."
    remove_one "$1" "$2" || STATUS=1
    ;;
remove-all)
    load_repos "$1"
    printf '  %s\n' "${REPOS[@]}"
    confirm "Remove '$2' from these ${#REPOS[@]} repositories?" || die "Aborted."
    run_bulk remove_one "$2" || STATUS=1
    ;;
user-access)
    user_access "$1" "$2"
    ;;
repo-users)
    repo_users "$1"
    ;;
esac

echoend
exit "$STATUS"
