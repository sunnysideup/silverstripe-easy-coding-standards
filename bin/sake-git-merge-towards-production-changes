#!/usr/bin/env bash
set -euo pipefail

############################################ BASICS
SCRIPT_DIR="${COMPOSER_RUNTIME_BIN_DIR:?COMPOSER_RUNTIME_BIN_DIR not set}"
WORKING_DIR="$(pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/sake-self-methods"
SCRIPT_SUMMARY="Compares a source branch (develop) against a destination branch (production), summarises the diff + commit messages, and adds a categorised entry to CHANGELOG.md"


############################################ DEFAULTS
# The compare branch defaults to the CURRENT git branch, resolved after we
# enter the repo (see INPUT RESOLUTION). Leave it empty here as the sentinel.
DEFAULT_DESTINATION_BRANCH='production'

# The runner that already knows how to resolve provider/model/auth and call opencode.
LLM_RUNNER="$SCRIPT_DIR/sake-llm-opencode"

# Paths (kept under .agents/ so sake-llm-opencode's gitignore handling covers them).
AGENTS_DIR='.agents/pre-prod'
INPUT_DIR="$AGENTS_DIR/input"          # only diff + commits live here (fed to opencode via --files)
COMMITS_FILE="$INPUT_DIR/commits.md"
DIFF_FILE="$INPUT_DIR/diff.patch"
PACKAGES_FILE="$INPUT_DIR/composer-packages.md"  # dependency delta (composer.lock is excluded from the diff)
PROMPT_FILE="$AGENTS_DIR/prompt.txt"   # kept OUTSIDE input/ so it isn't fed as an input file
COMPOSER_LOCK='composer.lock'          # relative to the repo root we cd into

# Files excluded from the diff (noise the model shouldn't waste tokens on).
DIFF_EXCLUDES=(
    ':(exclude)composer.lock'
    ':(exclude)package-lock.json'
    ':(exclude)yarn.lock'
    ':(exclude)*.min.js'
    ':(exclude)*.min.css'
)

# Guardrail: refuse diffs larger than this many lines (they blow the model's
# context window). Override at runtime with --max-diff-lines N.
DEFAULT_MAX_DIFF_LINES=50000

# Optional pricing for a rough pre-flight cost ESTIMATE, in your currency per
# 1,000,000 input tokens. Leave empty to show only a token estimate. Set it to
# your model's current input price (they change often, so it isn't hard-coded),
# e.g. export LLM_PRICE_INPUT_PER_M=1.25   or   --price-in 1.25
DEFAULT_PRICE_INPUT_PER_M=''

# Default instructions. Override with -i / --instructions FILE.
DEFAULT_INSTRUCTIONS="\
You are preparing a CHANGELOG entry for changes about to be deployed to the
destination branch. Read the attached files: the git commit list, the full
code diff, and (if present) the composer dependency delta.

Write for a human reader. Explain WHAT changed and WHY it matters in plain
language — describe behaviour and intent, not file names or raw diff lines.
Skip mechanical noise (formatting-only churn, lock files, build artefacts).

Categorise the meaningful changes under these Keep a Changelog headings,
omitting any heading that would be empty:
- Added
- Changed
- Deprecated
- Removed
- Fixed
- Security

Dependencies: if a composer package delta file is attached, add a short
'Dependencies' subsection summarising which packages were added, updated
(old -> new version), or removed. Call out MAJOR version bumps explicitly,
since those are the most likely to change behaviour.

Risks: add a final '⚠️ Review carefully' subsection listing anything that could
be risky to deploy — for example database schema/migration changes or
data-destructive operations; changes to authentication, permissions, or
security; configuration or environment-variable changes; removed or renamed
public methods/APIs; major dependency upgrades; anything touching payments,
emails, or user data. If nothing stands out, write 'Nothing obviously risky
spotted.' Do not invent risks that the diff does not support.

Then edit CHANGELOG.md in the repository root:
- Insert your new section at the TOP of the file, immediately under the main
  '# Changelog' title (create the file with that title if it does not exist).
- Do NOT modify, reorder, or reformat any existing entries.
- Use the exact version heading supplied below so the range is recorded and
  re-runs do not double up."


############################################ SETTINGS
dir='./'
compareBranch=''   # empty = use the current git branch (resolved below)
destinationBranch="$DEFAULT_DESTINATION_BRANCH"
instructionsFile=''
modelOverride=''
providerOverride=''
maxDiffLines="$DEFAULT_MAX_DIFF_LINES"
priceInputPerM="${LLM_PRICE_INPUT_PER_M:-$DEFAULT_PRICE_INPUT_PER_M}"
doFetch='yes'
dryRun='no'
help='no'


############################################ ARG PARSING
# Both 'space' (--foo VALUE) and '=' (--foo=VALUE) forms are accepted,
# matching the house style of sake-llm-opencode.
while (($#)); do
    case $1 in
    -h | --help)
        help='yes'
        ;;

    -b | --branch)
        compareBranch=$2
        shift
        ;;
    --branch=*)
        compareBranch="${1#*=}"
        ;;

    -d | --destination | -p | --production)
        destinationBranch=$2
        shift
        ;;
    --destination=* | --production=*)
        destinationBranch="${1#*=}"
        ;;

    -i | --instructions)
        instructionsFile=$2
        shift
        ;;
    --instructions=*)
        instructionsFile="${1#*=}"
        ;;

    -m | --model)
        modelOverride=$2
        shift
        ;;
    --model=*)
        modelOverride="${1#*=}"
        ;;

    --provider)
        providerOverride=$2
        shift
        ;;
    --provider=*)
        providerOverride="${1#*=}"
        ;;

    --max-diff-lines)
        maxDiffLines=$2
        shift
        ;;
    --max-diff-lines=*)
        maxDiffLines="${1#*=}"
        ;;

    --price-in)
        priceInputPerM=$2
        shift
        ;;
    --price-in=*)
        priceInputPerM="${1#*=}"
        ;;

    --no-fetch)
        doFetch='no'
        ;;

    -r | --dry-run)
        dryRun='yes'
        ;;

    *)
        if [[ "$1" == -* ]]; then
            if ! sake_handle_help_flag "$1"; then
                echobad "Unknown option: $1"
                exit 1
            fi
        else
            dir=$1
        fi
        ;;
    esac
    shift
done


############################################ HELP
help_and_exit() {
    ECHOHEAD "Pre-production analysis"
    echonice "Summarises everything going to the destination branch and adds it to CHANGELOG.md"
    echonice ""
    echonice "Directory of script:             $SCRIPT_DIR"
    echonice "Working dir:                     $WORKING_DIR"

    ECHOHEAD "Current settings:"
    echonice "target dir (positional):         $dir"
    echonice "compare branch (-b):             ${compareBranch:-'(current branch)'}"
    echonice "destination branch (-d):         $destinationBranch"
    echonice "instructions file (-i):          ${instructionsFile:-'(built-in default)'}"
    echonice "model (-m):                      ${modelOverride:-'(runner default)'}"
    echonice "provider (--provider):           ${providerOverride:-'(runner default)'}"
    echonice "max diff lines:                  $maxDiffLines"
    echonice "price /1M input tokens:          ${priceInputPerM:-'(unset; token estimate only)'}"
    echonice "git fetch first:                 $doFetch"
    echonice "dry run (-r):                    $dryRun"
    echonice "llm runner:                      $LLM_RUNNER"

    ECHOHEAD "Available settings (both 'space' and '=' forms accepted):"
    echonice "-b, --branch BRANCH              compare/source branch (default: current branch)"
    echonice "-d, --destination BRANCH         destination branch (default: $DEFAULT_DESTINATION_BRANCH)"
    echonice "                                 (-p / --production accepted as aliases)"
    echonice "-i, --instructions FILE          alternative instructions file"
    echonice "-m, --model MODEL                model to pass to the runner"
    echonice "    --provider PROVIDER          provider to pass to the runner"
    echonice "    --max-diff-lines N           refuse diffs bigger than N lines (default: $DEFAULT_MAX_DIFF_LINES)"
    echonice "    --price-in N                 price per 1M input tokens, for a rough cost estimate (or set LLM_PRICE_INPUT_PER_M)"
    echonice "    --no-fetch                   skip 'git fetch' before comparing"
    echonice "-r, --dry-run                    show what would be sent, do not call the LLM"
    echonice "-h, --help                       show help information"

    ECHOHEAD "Example usage:"
    echonice "sake-git-commit-pre-prod-analysis ."
    echonice "sake-git-commit-pre-prod-analysis . -b staging -d live"
    echonice "sake-git-commit-pre-prod-analysis . -b origin/develop -d origin/production --dry-run"

    echofunctions
    exit
}

if [[ "$help" == "yes" ]]; then
    help_and_exit
fi
sake_check_help_and_exit


############################################ INPUT RESOLUTION
if ! command -v git >/dev/null 2>&1; then
    echobad "Error: 'git' is not installed or not on PATH."
    exit 1
fi

if ! [[ "$maxDiffLines" =~ ^[0-9]+$ ]]; then
    echobad "Error: --max-diff-lines must be a positive integer (got: $maxDiffLines)"
    exit 1
fi

if [[ -n "$priceInputPerM" ]] && ! [[ "$priceInputPerM" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echobad "Error: --price-in must be a number (got: $priceInputPerM)"
    exit 1
fi

cd "$WORKING_DIR"
if [[ ! -d "$dir" ]]; then
    echobad "Error: directory not found (relative to $WORKING_DIR): $dir"
    exit 1
fi
cd "$dir"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echobad "Error: not a git repository: $(pwd)"
    exit 1
fi

# Default the compare branch to the branch currently checked out.
if [[ -z "$compareBranch" ]]; then
    compareBranch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [[ -z "$compareBranch" || "$compareBranch" == "HEAD" ]]; then
        echobad "Error: could not determine the current branch (detached HEAD?)."
        echonice "Pass one explicitly with -b BRANCH."
        exit 1
    fi
    echonice "Using current branch as compare branch: $compareBranch"
fi

if [[ -n "$instructionsFile" && ! -r "$instructionsFile" ]]; then
    echobad "Error: cannot read instructions file: $instructionsFile"
    exit 1
fi

if [[ ! -x "$LLM_RUNNER" && "$dryRun" != "yes" ]]; then
    echobad "Error: LLM runner not found or not executable: $LLM_RUNNER"
    exit 1
fi


############################################ GIT PREP
# 'git fetch --all' updates the remote-tracking refs (origin/*), which is all we
# need to compare against the LATEST destination — no branch checkout or 'git
# pull' required. Avoiding checkout means we never touch your working tree, never
# fail on uncommitted changes, and never leave you sitting on a different branch.
if [[ "$doFetch" == "yes" ]]; then
    echonice "Fetching latest refs..."
    git fetch --quiet --all --prune || echonice "(fetch failed or offline; continuing with local refs)"
fi

# Resolve a branch NAME to a ref that actually exists: prefer a local branch,
# then fall back to origin/<name>. This is what fixes "could not find
# production" — a production branch commonly exists only on the remote.
resolve_ref() {
    local b="$1"
    if git rev-parse --verify --quiet "$b^{commit}" >/dev/null 2>&1; then
        printf '%s' "$b"
    elif git rev-parse --verify --quiet "origin/$b^{commit}" >/dev/null 2>&1; then
        printf '%s' "origin/$b"
    fi
}

compareRef="$(resolve_ref "$compareBranch")"
destinationRef="$(resolve_ref "$destinationBranch")"

if [[ -z "$compareRef" ]]; then
    echobad "Error: compare branch not found locally or on origin: $compareBranch"
    exit 1
fi
if [[ -z "$destinationRef" ]]; then
    echobad "Error: destination branch not found locally or on origin: $destinationBranch"
    echonice "Tried '$destinationBranch' and 'origin/$destinationBranch'. Fetch first, or pass -d origin/<branch>."
    exit 1
fi

[[ "$compareRef" != "$compareBranch" ]] && echonice "Resolved compare branch to: $compareRef"
[[ "$destinationRef" != "$destinationBranch" ]] && echonice "Resolved destination branch to: $destinationRef"

logRange="$destinationRef..$compareRef"     # commits in compare, not in destination
diffRange="$destinationRef...$compareRef"    # changes compare added since the merge base

baseHash="$(git merge-base "$destinationRef" "$compareRef")"
fromHash="$(git rev-parse --short "$baseHash")"
untilHash="$(git rev-parse --short "$compareRef")"
today="$(date +%Y-%m-%d)"


############################################ BUILD INPUTS
# Start from a clean slate so a previous run's files can never leak into this one
# (the whole input dir is fed to the model via --files).
rm -rf "${INPUT_DIR:?INPUT_DIR is empty}"
mkdir -p "$INPUT_DIR"

# Let git fail loudly: both refs are already verified, so a failure here is a
# real problem (corruption, OOM, etc.) and must not silently ship empty files.
if ! git log --no-merges --date=short \
    --pretty=format:'- %h %s (%an, %ad)' \
    "$logRange" > "$COMMITS_FILE"; then
    echobad "Error: 'git log $logRange' failed."
    exit 1
fi

if [[ ! -s "$COMMITS_FILE" ]]; then
    echonice "No commits on '$compareBranch' that are missing from '$destinationBranch'. Nothing to do."
    exit 0
fi

if ! git diff "$diffRange" -- . "${DIFF_EXCLUDES[@]}" > "$DIFF_FILE"; then
    echobad "Error: 'git diff $diffRange' failed."
    exit 1
fi

# Dependency delta: composer.lock is excluded from the diff (huge and noisy), so
# summarise package version changes separately by diffing the lock's package
# list between the two refs. Compact and cheap for the model to read. Skipped
# gracefully if jq is missing, composer.lock is absent on either side, or the
# lock is unchanged.
build_composer_changes() {
    local fromRef="$1" toRef="$2" outFile="$3"

    if ! command -v jq >/dev/null 2>&1; then
        echonice "jq not found — skipping composer package summary."
        return 1
    fi
    if ! git cat-file -e "$fromRef:$COMPOSER_LOCK" 2>/dev/null \
        || ! git cat-file -e "$toRef:$COMPOSER_LOCK" 2>/dev/null; then
        echonice "composer.lock not present on both sides — skipping package summary."
        return 1
    fi

    local jqExtract='(.packages // []) + (."packages-dev" // []) | .[] | "\(.name) \(.version)"'
    local beforeList afterList changes
    beforeList="$(git show "$fromRef:$COMPOSER_LOCK" | jq -r "$jqExtract" | sort)" || return 1
    afterList="$(git show "$toRef:$COMPOSER_LOCK"  | jq -r "$jqExtract" | sort)" || return 1

    # Two "name version" lists -> Added / Updated / Removed lines.
    changes="$(awk '
        $1=="" { next }
        NR==FNR { before[$1]=$2; next }
        {
            after[$1]=$2
            if (!($1 in before))     print "- **Added:** " $1 " " $2
            else if (before[$1]!=$2) print "- **Updated:** " $1 " " before[$1] " -> " $2
        }
        END { for (n in before) if (!(n in after)) print "- **Removed:** " n " " before[n] }
    ' <(printf '%s\n' "$beforeList") <(printf '%s\n' "$afterList") | sort)"

    if [[ -z "$changes" ]]; then
        echonice "composer.lock unchanged between refs — no package summary needed."
        return 1
    fi

    {
        printf '# Composer package changes (%s -> %s)\n\n' "$fromRef" "$toRef"
        printf '%s\n' "$changes"
    } > "$outFile"
    return 0
}

composerChangeCount=0
if build_composer_changes "$destinationRef" "$compareRef" "$PACKAGES_FILE"; then
    composerChangeCount="$(grep -c '^- ' "$PACKAGES_FILE" || true)"
    echonice "Composer package delta: $composerChangeCount change(s) -> $PACKAGES_FILE"
fi

commitCount="$(grep -c '^- ' "$COMMITS_FILE" || true)"
diffLines="$(wc -l < "$DIFF_FILE" | tr -d ' ')"

# Guardrail: an oversized diff will blow the model's context window. Stop rather
# than truncate — a diff cut mid-hunk yields a plausible but wrong changelog.
if (( diffLines > maxDiffLines )); then
    echobad "Error: diff is $diffLines lines (limit: $maxDiffLines)."
    echonice "This will likely exceed the model's context window. Options:"
    echonice "  - narrow the range with -b / -d"
    echonice "  - add more paths to DIFF_EXCLUDES near the top of this script"
    echonice "  - raise the cap with --max-diff-lines N (at your own risk)"
    exit 1
fi


############################################ BUILD PROMPT
if [[ -n "$instructionsFile" ]]; then
    instructionsText="$(cat "$instructionsFile")"
else
    instructionsText="$DEFAULT_INSTRUCTIONS"
fi

packagesLine=''
[[ -f "$PACKAGES_FILE" ]] && packagesLine="- ${PACKAGES_FILE} : composer dependency changes (added / updated / removed)"

cat > "$PROMPT_FILE" <<EOF
$instructionsText

Use this EXACT heading for the new CHANGELOG.md section:

## [Unreleased] — from ${fromHash} to ${untilHash} (${today})

Comparing: ${compareRef}  ->  ${destinationRef}
The attached input files are:
- ${COMMITS_FILE} : the list of commits going to the destination branch
- ${DIFF_FILE} : the full code diff (composer.lock and other lock/min files excluded)
${packagesLine}
EOF


############################################ REPORT + RUN
ECHOHEAD "Pre-production analysis"
echonice "compare -> destination:          $compareRef -> $destinationRef"
echonice "commit range:                    $logRange"
echonice "diff range:                      $diffRange"
echonice "hash range:                      $fromHash .. $untilHash"
echonice "commits found:                   $commitCount"
echonice "diff size (lines):               $diffLines / $maxDiffLines"
echonice "composer changes:                $composerChangeCount"

# Rough pre-flight cost ESTIMATE. Counts the bytes we send (prompt + input
# files) and estimates tokens at ~4 chars/token. This is INPUT only and EXCLUDES
# opencode's own system/agent prompt, so treat it as a lower bound.
inputBytes="$( { cat "$PROMPT_FILE" "$INPUT_DIR"/* 2>/dev/null || true; } | wc -c | tr -d ' ')"
estInputTokens=$(( inputBytes / 4 ))
echonice "est. input size:                 ${inputBytes} bytes (~${estInputTokens} tokens, input only)"
if [[ -n "$priceInputPerM" ]]; then
    estCost="$(awk -v t="$estInputTokens" -v p="$priceInputPerM" 'BEGIN{ printf "%.4f", (t/1000000.0)*p }')"
    echonice "est. input cost:                 ~${estCost} (at ${priceInputPerM}/1M input tokens; OUTPUT billed on top)"
else
    echonice "est. input cost:                 set --price-in N or LLM_PRICE_INPUT_PER_M to get a figure"
fi

# Delegate to the existing runner (handles provider/model/auth/install/opencode).
runnerArgs=( "./" --files "$INPUT_DIR/*" --prompt "$PROMPT_FILE" )
[[ -n "$modelOverride" ]]    && runnerArgs+=( --model "$modelOverride" )
[[ -n "$providerOverride" ]] && runnerArgs+=( --provider "$providerOverride" )
[[ "$dryRun" == "yes" ]]     && runnerArgs+=( --dry-run )

ECHOHEAD "Handing off to: $LLM_RUNNER"
echonice "${runnerArgs[*]}"

"$LLM_RUNNER" "${runnerArgs[@]}"

# opencode does not reliably emit per-call cost on stdout (the final usage event
# is often dropped), so point at its own accounting for the real figure.
if [[ "$dryRun" != "yes" ]]; then
    ECHOHEAD "LLM usage / cost"
    echonice "The estimate above is input-only. For actual billed tokens & cost, run:"
    echonice "  opencode stats"
fi


git add CHANGELOG.md
git commit . -m "DOC: adding notes in CHANGELOG.md"

echoend
