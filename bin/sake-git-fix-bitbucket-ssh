#!/usr/bin/env bash

############################################ BASICS
SCRIPT_DIR="${COMPOSER_RUNTIME_BIN_DIR:?COMPOSER_RUNTIME_BIN_DIR not set}"
WORKING_DIR=$(pwd)
source "$SCRIPT_DIR/sake-self-methods"
SCRIPT_SUMMARY="Moves Bitbucket SSH access to ssh.bitbucket.org (remotes, ssh config, known_hosts, git config)"

############################################ DIR
dir=''
defaultContainerDir='/container/application'

############################################ SETTINGS
help='no'
dryRun='no'
verify='no'
fixFiles='no'
doMachine='yes'
doRepos='yes'
while (($#)); do
    case $1 in
    -n | --dry-run)
        dryRun='yes'
        ;;
    -v | --verify)
        verify='yes'
        ;;
    -F | --fix-files)
        fixFiles='yes'
        ;;
    --repos-only)
        doMachine='no'
        ;;
    --machine-only)
        doRepos='no'
        ;;
    *)
        if sake_handle_help_flag "$1"; then
            shift
            continue
        fi
        dir=$1
        ;;
    esac
    shift
done

# default: SiteHost container location if it exists, otherwise the current directory
if [ -z "$dir" ]; then
    if [ -d "$defaultContainerDir" ]; then
        dir="$defaultContainerDir"
    else
        dir='./'
    fi
fi

case "$dir" in
/*) rootDir="$dir" ;;
*) rootDir="$WORKING_DIR/$dir" ;;
esac

############################################ HELP

help_and_exit() {
    ECHOHEAD "Git fix Bitbucket SSH host (bitbucket.org -> ssh.bitbucket.org)"
    echonice "$SCRIPT_SUMMARY"
    echonice ""
    echonice "Bitbucket Cloud no longer accepts SSH on bitbucket.org. This script:"
    echonice "  1. machine: adds ssh.bitbucket.org to ~/.ssh/known_hosts (fingerprints verified)"
    echonice "  2. machine: adds ssh.bitbucket.org to any 'Host bitbucket.org' block in ~/.ssh/config"
    echonice "  3. machine: adds global git 'insteadOf' rules as a safety net (composer, npm, scripts)"
    echonice "  4. machine: rewrites remotes in the composer VCS cache"
    echonice "  5. repos:   rewrites remote / pushurl / submodule urls in every git repo below the directory"
    echonice "  6. repos:   reports (or fixes with -F) composer.json, .gitmodules, etc. that still use the old host"
    echonice "HTTPS urls (https://bitbucket.org/...) are left alone - they are not affected."
    echonice ""
    echonice "directory of script:           $SCRIPT_DIR"
    echonice "directory to fix:              $rootDir"
    echonice "default directory:             $defaultContainerDir (if it exists), otherwise current directory"

    ECHOHEAD "Available settings:"
    echonice "-h, --help                     show help information"
    echonice "-n, --dry-run                  show what would change, change nothing"
    echonice "-v, --verify                   test 'git ls-remote' on each Bitbucket repo after fixing"
    echonice "-F, --fix-files                also rewrite composer.json, composer.lock, .gitmodules, package.json, *.yml ..."
    echonice "    --repos-only               skip ssh config / known_hosts / global git config"
    echonice "    --machine-only             only fix ssh config / known_hosts / global git config"

    ECHOHEAD "Example usage:"
    echonice "e.g. sake-git-fix-bitbucket-ssh                  (on SiteHost: fixes $defaultContainerDir)"
    echonice "e.g. sake-git-fix-bitbucket-ssh /var/www -n"
    echonice "e.g. sake-git-fix-bitbucket-ssh ~/projects -v -F"

    echofunctions
    exit
}

sake_check_help_and_exit

############################################ CONSTANTS

NEW_HOST='ssh.bitbucket.org'

# published by Atlassian - same keys as bitbucket.org
EXPECTED_FINGERPRINTS=(
    'SHA256:FC73VB6C4OQLSCrjEayhMp9UMxS97caD/Yyi2bhW/J0'
    'SHA256:ybgmFkzwOSotHTHLJgHO0QN8L0xErw6vd0VhFA9m3SM'
    'SHA256:46OSHA1Rmj8E8ERTC6xkNcmGOw9oFxYr0WF6zWW8l1E'
)

# matches old SSH urls anywhere in a file
OLD_URL_GREP='git@bitbucket\.org:|ssh://([^@/" ]+@)?bitbucket\.org[:/]'

timestamp=$(date +%Y%m%d%H%M%S)
countReposChanged=0
countProblems=0

############################################ HELPERS

withTimeout() {
    local seconds="$1"
    shift

    if command -v timeout >/dev/null 2>&1; then
        timeout "${seconds}s" "$@"
    else
        "$@"
    fi
}

run() {
    if [ "$dryRun" = 'yes' ]; then
        echonice "   [dry-run] $*"
    else
        "$@"
    fi
}

backupFile() {
    local file="$1"
    [ -f "$file" ] || return 0
    run cp -p "$file" "$file.bak-$timestamp"
}

# rewrite a single url (anchored) - leaves https:// untouched
rewriteUrl() {
    sed -E \
        -e 's#^([A-Za-z0-9._-]+@)?bitbucket\.org:#\1ssh.bitbucket.org:#' \
        -e 's#^(ssh|git\+ssh|ssh\+git)://([^@/]+@)?bitbucket\.org([:/])#\1://\2ssh.bitbucket.org\3#' \
        <<<"$1"
}

# rewrite old urls anywhere in a file (in place)
rewriteFile() {
    sed -E -i \
        -e 's#git@bitbucket\.org:#git@ssh.bitbucket.org:#g' \
        -e 's#ssh://([^@/" ]+@)?bitbucket\.org([:/])#ssh://\1ssh.bitbucket.org\2#g' \
        "$1"
}

isBitbucketSsh() {
    case "$1" in
    *@ssh.bitbucket.org:* | ssh.bitbucket.org:* | *://ssh.bitbucket.org* | *://*@ssh.bitbucket.org*) return 0 ;;
    esac
    return 1
}

############################################ MACHINE: known_hosts

fixKnownHosts() {
    local knownHosts="$HOME/.ssh/known_hosts"

    ECHOHEAD "known_hosts: $knownHosts"

    if [ -f "$knownHosts" ] && ssh-keygen -F "$NEW_HOST" -f "$knownHosts" >/dev/null 2>&1; then
        echonice "already contains $NEW_HOST"
        return 0
    fi

    if ! command -v ssh-keyscan >/dev/null 2>&1; then
        echonice "ERROR: ssh-keyscan not found - cannot add $NEW_HOST"
        countProblems=$((countProblems + 1))
        return 1
    fi

    local scanned lineFile line fingerprint expected ok
    local -a goodLines=()
    scanned="$(withTimeout 15 ssh-keyscan -t rsa,ecdsa,ed25519 "$NEW_HOST" 2>/dev/null || true)"
    lineFile="$(mktemp)"

    while IFS= read -r line; do
        [ -z "$line" ] && continue
        [[ "$line" == \#* ]] && continue
        printf '%s\n' "$line" >"$lineFile"
        fingerprint="$(ssh-keygen -lf "$lineFile" 2>/dev/null | awk '{print $2}')"
        ok='no'
        for expected in "${EXPECTED_FINGERPRINTS[@]}"; do
            [ "$fingerprint" = "$expected" ] && ok='yes'
        done
        if [ "$ok" = 'yes' ]; then
            goodLines+=("$line")
            echonice "verified key $fingerprint"
        else
            echonice "WARNING: ignoring key with unexpected fingerprint: ${fingerprint:-unknown}"
            countProblems=$((countProblems + 1))
        fi
    done <<<"$scanned"
    rm -f "$lineFile"

    if [ "${#goodLines[@]}" -eq 0 ]; then
        echonice "ERROR: could not get verified keys for $NEW_HOST (network / firewall on port 22?)"
        countProblems=$((countProblems + 1))
        return 1
    fi

    if [ "$dryRun" = 'yes' ]; then
        echonice "   [dry-run] would append ${#goodLines[@]} key(s) to $knownHosts"
        return 0
    fi

    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    printf '%s\n' "${goodLines[@]}" >>"$knownHosts"
    chmod 600 "$knownHosts"
    echonice "added ${#goodLines[@]} key(s) for $NEW_HOST"
}

############################################ MACHINE: ssh config

# 'Host bitbucket.org'        -> 'Host bitbucket.org ssh.bitbucket.org' (keeps IdentityFile etc.)
# 'HostName bitbucket.org'    -> 'HostName ssh.bitbucket.org'           (aliases like 'Host bb')
fixSshConfigFile() {
    local file="$1"
    local tmp
    tmp="$(mktemp)"

    awk -v newHost="$NEW_HOST" '
    {
        line = $0
        n = split(line, t, /[ \t]+/)
        first = ""; fi = 0
        for (i = 1; i <= n; i++) {
            if (t[i] != "") { first = tolower(t[i]); fi = i; break }
        }
        if (first == "host") {
            hasOld = 0; hasNew = 0
            for (i = fi + 1; i <= n; i++) {
                v = tolower(t[i])
                if (v == "bitbucket.org") hasOld = 1
                if (v == newHost) hasNew = 1
            }
            if (hasOld && !hasNew) {
                sub(/[ \t]+$/, "", line)
                print line " " newHost
                next
            }
        }
        if (first == "hostname" && tolower(t[fi + 1]) == "bitbucket.org") {
            sub(/[Bb][Ii][Tt][Bb][Uu][Cc][Kk][Ee][Tt]\.[Oo][Rr][Gg][ \t]*$/, newHost, line)
        }
        print line
    }' "$file" >"$tmp"

    if cmp -s "$file" "$tmp"; then
        echonice "no change needed: $file"
        rm -f "$tmp"
        return 0
    fi

    echonice "updating: $file"
    diff "$file" "$tmp" | sed 's/^/      /'
    if [ "$dryRun" != 'yes' ]; then
        backupFile "$file"
        # cat keeps owner, permissions and symlinks intact
        cat "$tmp" >"$file"
    fi
    rm -f "$tmp"
}

fixSshConfig() {
    ECHOHEAD "ssh config"
    local file found='no'
    for file in "$HOME/.ssh/config" "$HOME"/.ssh/config.d/*; do
        [ -f "$file" ] || continue
        found='yes'
        fixSshConfigFile "$file"
    done
    [ "$found" = 'no' ] && echonice "no ssh config found - nothing to do (default key will be used)"
}

############################################ MACHINE: global git insteadOf

addInsteadOf() {
    local base="$1"
    local old="$2"

    if git config --global --get-all "url.$base.insteadOf" 2>/dev/null | grep -Fxq -- "$old"; then
        echonice "already set: $old -> $base"
    else
        echonice "adding: $old -> $base"
        run git config --global --add "url.$base.insteadOf" "$old"
    fi
}

fixGlobalGit() {
    ECHOHEAD "global git config (safety net for composer / npm / scripts)"
    addInsteadOf "git@$NEW_HOST:" "git@bitbucket.org:"
    addInsteadOf "ssh://git@$NEW_HOST/" "ssh://git@bitbucket.org/"
}

############################################ REPOS

# rewrites remote.*.url, remote.*.pushurl and submodule.*.url in one repo (works for bare repos too)
fixRepoRemotes() {
    local repoDir="$1"
    local key value newValue differs i
    local -a keys values newValues

    mapfile -t keys < <(
        git -C "$repoDir" config --local --get-regexp '^(remote\..*\.(push)?url|submodule\..*\.url)$' 2>/dev/null |
            awk '{print $1}' | sort -u
    )
    [ "${#keys[@]}" -eq 0 ] && return 1

    local repoChanged='no'
    for key in "${keys[@]}"; do
        mapfile -t values < <(git -C "$repoDir" config --local --get-all "$key" 2>/dev/null)
        newValues=()
        differs='no'
        for value in "${values[@]}"; do
            newValue="$(rewriteUrl "$value")"
            newValues+=("$newValue")
            [ "$newValue" != "$value" ] && differs='yes'
        done
        [ "$differs" = 'yes' ] || continue

        [ "$repoChanged" = 'no' ] && echonice "$repoDir"
        repoChanged='yes'
        for i in "${!values[@]}"; do
            [ "${values[$i]}" != "${newValues[$i]}" ] && echonice "   $key: ${values[$i]} -> ${newValues[$i]}"
        done
        if [ "$dryRun" != 'yes' ]; then
            git -C "$repoDir" config --local --unset-all "$key"
            for newValue in "${newValues[@]}"; do
                git -C "$repoDir" config --local --add "$key" "$newValue"
            done
        fi
    done

    if [ "$repoChanged" = 'yes' ]; then
        countReposChanged=$((countReposChanged + 1))
        return 0
    fi
    return 1
}

verifyRepo() {
    local repoDir="$1"
    local remote url

    while IFS= read -r remote; do
        url="$(git -C "$repoDir" remote get-url "$remote" 2>/dev/null || true)"
        isBitbucketSsh "$url" || continue
        if GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes" \
            withTimeout 20 git -C "$repoDir" ls-remote --heads "$remote" >/dev/null 2>&1; then
            echonice "   OK      $repoDir ($remote)"
        else
            echonice "   FAILED  $repoDir ($remote) $url  <- check key / repo access"
            countProblems=$((countProblems + 1))
        fi
    done < <(git -C "$repoDir" remote 2>/dev/null)
}

fixComposerCache() {
    ECHOHEAD "composer VCS cache"
    local cacheDir='' candidate repo found='no'

    if command -v composer >/dev/null 2>&1; then
        cacheDir="$(COMPOSER_ALLOW_SUPERUSER=1 composer config --global cache-vcs-dir 2>/dev/null || true)"
    fi
    for candidate in "$cacheDir" "$HOME/.cache/composer/vcs" "$HOME/.composer/cache/vcs"; do
        [ -n "$candidate" ] && [ -d "$candidate" ] || continue
        found='yes'
        for repo in "$candidate"/*/; do
            [ -d "$repo" ] || continue
            fixRepoRemotes "${repo%/}" || true
        done
    done
    [ "$found" = 'no' ] && echonice "no composer VCS cache found"
}

fixRepos() {
    ECHOHEAD "git repositories below $rootDir"
    local gitPath repoDir
    local -a bitbucketRepos=()

    while IFS= read -r -d '' gitPath; do
        repoDir="${gitPath%/.git}"
        git -C "$repoDir" rev-parse --git-dir >/dev/null 2>&1 || continue
        fixRepoRemotes "$repoDir" || true
        if [ "$verify" = 'yes' ] &&
            git -C "$repoDir" config --local --get-regexp '^remote\..*\.url$' 2>/dev/null | grep -q 'ssh\.bitbucket\.org'; then
            bitbucketRepos+=("$repoDir")
        fi
    done < <(find "$rootDir" -name .git -prune -print0 2>/dev/null)

    [ "$countReposChanged" -eq 0 ] && echonice "no repositories needed changing"

    if [ "$verify" = 'yes' ]; then
        ECHOHEAD "verifying access (git ls-remote)"
        if [ "$dryRun" = 'yes' ]; then
            echonice "skipped in dry-run"
        elif [ "${#bitbucketRepos[@]}" -eq 0 ]; then
            echonice "no Bitbucket SSH repos found"
        else
            for repoDir in "${bitbucketRepos[@]}"; do
                verifyRepo "$repoDir"
            done
        fi
    fi
}

fixTrackedFiles() {
    ECHOHEAD "files still referencing the old SSH host"
    local file
    local -a files=()

    mapfile -t files < <(
        grep -rIlE \
            --exclude-dir=vendor --exclude-dir=node_modules --exclude-dir=.git \
            --exclude-dir=resources --exclude-dir=_resources --exclude-dir=public \
            --include=composer.json --include=composer.lock --include=.gitmodules \
            --include=package.json --include=package-lock.json --include=yarn.lock \
            --include='*.yml' --include='*.yaml' --include='.env' --include='*.sh' \
            "$OLD_URL_GREP" "$rootDir" 2>/dev/null
    )

    if [ "${#files[@]}" -eq 0 ]; then
        echonice "none found"
        return 0
    fi

    for file in "${files[@]}"; do
        echonice "$file"
        grep -nE "$OLD_URL_GREP" "$file" | head -n 5 | sed 's/^/      /'
        if [ "$fixFiles" = 'yes' ] && [ "$dryRun" != 'yes' ]; then
            rewriteFile "$file"
            echonice "   -> fixed"
        fi
    done

    if [ "$fixFiles" = 'yes' ]; then
        echonice ""
        echonice "If composer.json changed, run: composer update --lock   (refreshes the content-hash)"
        echonice "If .gitmodules changed, run:   git submodule sync --recursive"
        echonice "Then commit these files."
    else
        echonice ""
        echonice "Not changed (the global insteadOf rule covers them on this machine)."
        echonice "Run again with -F to rewrite them so other machines / CI get the fix too."
    fi
}

testSshConnection() {
    ECHOHEAD "testing ssh git@$NEW_HOST"
    local out
    out="$(withTimeout 20 ssh -T -o BatchMode=yes -o ConnectTimeout=10 "git@$NEW_HOST" 2>&1 || true)"
    if grep -qiE 'authenticated|logged in as' <<<"$out"; then
        echonice "OK: $(head -n 1 <<<"$out")"
    else
        echonice "FAILED:"
        sed 's/^/      /' <<<"$out"
        echonice "Check that this machine's public key is added to Bitbucket (account or access key)."
        countProblems=$((countProblems + 1))
    fi
}

############################################ CODE

[ "$dryRun" = 'yes' ] && ECHOHEAD "DRY RUN - nothing will be changed"

if [ "$doRepos" = 'yes' ]; then
    cd_or_fail "$rootDir" help_and_exit
    rootDir="$(pwd)"
fi

if [ "$doMachine" = 'yes' ]; then
    fixKnownHosts || true
    fixSshConfig
    fixGlobalGit
    fixComposerCache
    testSshConnection
fi

if [ "$doRepos" = 'yes' ]; then
    fixRepos
    fixTrackedFiles
fi

ECHOHEAD "Summary"
echonice "repositories updated:  $countReposChanged"
echonice "problems:              $countProblems"

echoend
