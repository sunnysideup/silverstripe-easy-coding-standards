#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

# Catch unexpected early exits (e.g. from set -e) and show a hint rather than silence.
trap 'echo "sake-ss-rsync-assets: unexpected error on line $LINENO — run with bash -x for details." >&2' ERR

############################################ BASICS
SCRIPT_DIR="${COMPOSER_RUNTIME_BIN_DIR:?COMPOSER_RUNTIME_BIN_DIR not set}"
WORKING_DIR=$(pwd)
source "$SCRIPT_DIR/sake-self-methods"
SCRIPT_SUMMARY="Syncs public/assets folder between local and remote server via rsync"

############################################ CONSTANTS / DEFAULTS
LOCAL_ASSETS_DIR="$WORKING_DIR/public/assets"
REMOTE_ASSETS_SUBPATH='public/assets'
WWW_DATA_DEFAULT='www-data'
envServerKey='SS_SERVER_FOR_EXAMPLE_DATA'

# The one entry preserved on the DESTINATION during any sync. --exclude does two
# jobs here: the sender's copy is never transferred (so the destination's own
# file is left untouched), and --delete never removes it. Everything else in the
# assets root is mirrored to match the sender exactly (dest-only files, incl.
# hidden ones like .protected, are deleted).
KEEP_NAME='.htaccess'
RSYNC_OPTS=(--stats -chavzPr --delete --exclude="/$KEEP_NAME")

############################################ SETTINGS (args)
server=''
toServer=''
wwwDataUser="$WWW_DATA_DEFAULT"
help='no'
reverse='no'

serverFromArg=''
while (($#)); do
    case $1 in
        -w|--www-data-user) wwwDataUser=$2; shift ;;
        -h|--help) help='yes' ;;
        -r|--reverse) reverse='yes' ;;
        -t|--to) toServer=$2; shift ;;
    *)
        if sake_handle_help_flag "$1"; then
            shift
            continue
        fi
        serverFromArg=$1
        ;;
    esac
    shift
done

############################################ RESOLVE SERVER (arg ALWAYS overrules .env)
serverFromEnv="$(read_local_dotenv_value "$envServerKey" || true)"
serverSource=''
if [[ -n "$serverFromArg" ]]; then
    server="$serverFromArg"
    serverSource="argument"
    if [[ -n "$serverFromEnv" && "$(normalize_server "$serverFromArg")" != "$(normalize_server "$serverFromEnv")" ]]; then
        echowarn "Note: argument server ($serverFromArg) differs from .env $envServerKey ($serverFromEnv)."
        echowarn "Using the argument server."
    fi
elif [[ -n "$serverFromEnv" ]]; then
    server="$serverFromEnv"
    serverSource=".env ($envServerKey)"
fi

[[ -n "$server" ]] && server="$(normalize_server "$server")"

############################################ HELP
help_and_exit() {
    # Show resolved targets (lazy-resolve so help is informative without side-effects)
    _server_display="${server:-<none>}"
    _to_display="${toServer:-<none>}"


    ECHOHEAD 'Rsync SilverStripe assets'
    echonice "$SCRIPT_SUMMARY"
    echonice ""
    echonice "Mirrors the public/assets folder between local and remote via rsync."
    echonice "The destination is made to match the sender EXACTLY: files that only"
    echonice "exist on the destination (including hidden ones such as .protected) are"
    echonice "deleted. The single exception is $KEEP_NAME, which is always left as-is."
    echonice ""
    echonice "Script dir:                    $SCRIPT_DIR"
    echonice "Working dir:                   $WORKING_DIR"
    echonice "Local assets dir:              $LOCAL_ASSETS_DIR"
    echonice "Remote assets subpath:         $REMOTE_ASSETS_SUBPATH"
    echonice "Preserved on destination:      $KEEP_NAME"
    echonice "Rsync options:                 ${RSYNC_OPTS[*]}"
    echonice "Server (- none if blank):      $_server_display"
    echonice "To server (post-pull push):    $_to_display"
    echonice "Reverse push (-r):             $reverse"
    echonice "Apache user (-w):              $wwwDataUser"

    ECHOHEAD 'Options'
    echonice "-w, --www-data-user <user>     Apache (owner) user. Default: $WWW_DATA_DEFAULT"
    echonice "-r, --reverse                  Push LOCAL → SERVER (dangerous)."
    echonice "-t, --to <srv[:/path]>         After pulling, push LOCAL → this server."
    echonice "-h, --help                     Show this help."

    ECHOHEAD 'Usage'
    echonice "Pull:       sake-ss-rsync-assets user@host:/var/www/site"
    echonice "Pull+Push:  sake-ss-rsync-assets user@hostA:/var/www/site --to user@hostB:/var/www/site"
    echonice "Push:       sake-ss-rsync-assets -r user@host:/var/www/site"
    echonice "Note: The destination is mirrored to the sender (--delete); destination-only"
    echonice "      files are removed. Only $KEEP_NAME is preserved on the destination."
    echonice "Note: Use trailing slashes correctly in rsync semantics (src/ vs src)."
    ECHOHEAD "Setting defaults:"
    echonice "Set default server in .env with key $envServerKey,"
    echonice " e.g. $envServerKey=my-server:/var/www/website-root"
    echofunctions
    exit 0
}
sake_check_help_and_exit

if [[ -z "${server:-}" ]]; then
    help_and_exit
fi

[[ "$reverse" == 'yes' ]] && echobad 'CAREFUL: you are pushing to the server.'

############################################ HELPERS

server_host() { echo "${1%%:*}"; }
server_path() { echo "${1#*:}"; }

############################################ PREP
# Ensure local assets dir exists and is writable for rsync
sudo mkdir -p "$LOCAL_ASSETS_DIR"
sudo chown "$USER" "$LOCAL_ASSETS_DIR" -R


SERVER_HOST="$(server_host "$server")"
SERVER_PATH="$(server_path "$server")"
REMOTE_ASSETS_DIR="$SERVER_PATH/$REMOTE_ASSETS_SUBPATH"

# Normalize optional toServer
TO_NORMALIZED=''
if [[ -n "${toServer:-}" ]]; then
    TO_NORMALIZED="$(normalize_server "$toServer")"
fi

############################################ RUN
cd "$WORKING_DIR" || { echobad "Cannot cd to $WORKING_DIR"; exit 1; }

if [[ "$reverse" == 'yes' ]]; then
    ECHOHEAD "DANGER: REVERSE SYNC (LOCAL → REMOTE assets)"
    echowarn "Target server:        $server"
    echowarn "Server source:        ${serverSource:-unknown}"
    echowarn "Remote assets dir:    $REMOTE_ASSETS_DIR"
    echowarn "Local assets dir:     $LOCAL_ASSETS_DIR"
    echowarn "This MIRRORS local → remote: remote-only files will be DELETED"
    echowarn "(everything except $KEEP_NAME, which is left untouched on the remote)."
    read -p "Type the server host name ($SERVER_HOST) to confirm: " confirm
    [[ "$confirm" != "$SERVER_HOST" ]] && echonice 'Aborted (input did not match server host).' && exit 1
    rsync "${RSYNC_OPTS[@]}" "$LOCAL_ASSETS_DIR/" "$server/$REMOTE_ASSETS_SUBPATH"
else
    ECHOHEAD "Now mirroring $server → LOCAL (deletes local-only files, keeps $KEEP_NAME)..."
    rsync "${RSYNC_OPTS[@]}" "$server/$REMOTE_ASSETS_SUBPATH/" "$LOCAL_ASSETS_DIR"
fi

# Restore web user ownership
sudo chown "$wwwDataUser" "$LOCAL_ASSETS_DIR" -R || true

############################################ OPTIONAL POST-PULL PUSH
if [[ -n "$TO_NORMALIZED" && "$reverse" != 'yes' ]]; then
    TO_HOST="$(server_host "$TO_NORMALIZED")"
    TO_PATH="$(server_path "$TO_NORMALIZED")"
    TO_ASSETS_DIR="$TO_PATH/$REMOTE_ASSETS_SUBPATH"

    ECHOHEAD "Now syncing LOCAL → $TO_NORMALIZED ..."
    echonice "Re-invoking in reverse mode for safety and consistency."
    "$0" -w "$wwwDataUser" --reverse "$TO_NORMALIZED"
fi

echoend
