#!/usr/bin/env bash

############################################ BASICS
SCRIPT_DIR="${COMPOSER_RUNTIME_BIN_DIR:?COMPOSER_RUNTIME_BIN_DIR not set}"
WORKING_DIR=$(pwd)
source "$SCRIPT_DIR/sake-self-methods"
SCRIPT_SUMMARY="For every repo of an owner where branch 5 (SS5) is ahead of main (SS6): bring the SS5 work into main, either by merging 5 (after a Rector pass on a copy of 5) or, when that conflicts too much, by rebuilding main from an SS6 upgrade of 5. Branch 5 stays SS5."

############################################ SETTINGS
owner='sunnysideup'
limit=1000
sourceBranch='5'       # branch holding SS5 work (stays SS5: only the CHANGELOG.md commit is ever added to it)
baseBranch=''          # branch that receives the work (default: repo default branch, i.e. main)
workDir="${TMPDIR:-/tmp}/sake-upgrade-5-to-6"
rectorConfig='SS62'
only=''                # comma separated repo names (without owner)
skip=''                # comma separated repo names to skip
assumeYes='no'         # don't ask per repo
runChangelog='yes'     # run sake-git-merge-towards-production-changes on the source branch first
dryRun='no'
push='no'
prMode='no'            # open a pull request instead of changing base directly
prBranch='upgrade/ss6-merge-5'
prDraft='yes'
forcePr='no'           # rebuild an existing PR branch (force-with-lease)
useLlm='yes'
provider=''
model=''
verbose='no'
maxCost=''             # stop everything once total LLM spend (USD) reaches this
conflictBatch=8        # max conflicted files per LLM call; files are grouped per folder (each call has a fixed overhead)
conflictBytes=160000   # ...and a call is also capped at about this many bytes of conflicted files
thinking='no'
verifyInstall='no'     # composer install + phpunit against SS6 in a scratch copy
verifySoft='no'        # install/test failures are reported in the PR instead of failing the repo
VERIFY_TIMEOUT=1800
VERIFY_SUMMARY='static checks only (composer validate, php -l); dependencies were NOT installed and PHPUnit was NOT run'

strategy='auto'        # auto | merge | rebuild
prep='yes'             # merge path: run Rector on a scratch copy of the source branch first (turns most mechanical conflicts into clean merges)
conflictLimit=10       # auto: more conflicted files than this (after the Rector prep) = too many to merge
mainWorkLimit=5        # auto: rebuild only when base has at most this many own (non-upgrade) commits since 5 and main split
upgradeCmd=''          # rebuild path: optional command that upgrades the code to SS6 (runs inside the repo, after Rector)
# commit subjects matching this are "upgrade / maintenance" work on base, not features (they are not copied across on rebuild)
upgradeRegex='rector|upgrad|ss ?6|silverstripe ?6|cms ?6|php ?8|lint|php-?cs|cs-?fix|phpstan|composer|changelog|^(MNT|DEP|DOC)\b'

while (($#)); do
    case $1 in
    -o | --owner)
        owner="${2:-}"
        shift
        ;;
    -l | --limit)
        limit="${2:-1000}"
        shift
        ;;
    -s | --source)
        sourceBranch="${2:-}"
        shift
        ;;
    -b | --base)
        baseBranch="${2:-}"
        shift
        ;;
    -w | --work-dir)
        workDir="${2:-}"
        shift
        ;;
    -r | --rector-config)
        rectorConfig="${2:-}"
        shift
        ;;
    --only)
        only="${2:-}"
        shift
        ;;
    --skip)
        skip="${2:-}"
        shift
        ;;
    -y | --yes)
        assumeYes='yes'
        ;;
    --no-changelog)
        runChangelog='no'
        ;;
    -d | --dry-run)
        dryRun='yes'
        ;;
    -p | --push)
        push='yes'
        ;;
    --pr)
        prMode='yes'
        ;;
    --pr-branch)
        prBranch="${2:-}"
        shift
        ;;
    --no-draft)
        prDraft='no'
        ;;
    --force-pr)
        forcePr='yes'
        ;;
    --no-llm)
        useLlm='no'
        ;;
    --provider)
        provider="${2:-}"
        shift
        ;;
    -m | --model)
        model="${2:-}"
        shift
        ;;
    --max-cost)
        maxCost="${2:-}"
        shift
        ;;
    --conflict-batch)
        conflictBatch="${2:-8}"
        shift
        ;;
    --thinking)
        thinking='yes'
        ;;
    --verify-install)
        verifyInstall='yes'
        ;;
    --verify-soft)
        verifySoft='yes'
        ;;
    --strategy)
        strategy="${2:-auto}"
        shift
        ;;
    --no-prep)
        prep='no'
        ;;
    --conflict-limit)
        conflictLimit="${2:-10}"
        shift
        ;;
    --main-work-limit)
        mainWorkLimit="${2:-5}"
        shift
        ;;
    --upgrade-cmd)
        upgradeCmd="${2:-}"
        shift
        ;;
    --upgrade-regex)
        upgradeRegex="${2:-$upgradeRegex}"
        shift
        ;;
    -v | --verbose)
        verbose='yes'
        ;;
    *)
        if sake_handle_help_flag "$1"; then
            shift
            continue
        fi
        echobad "Unknown option: $1"
        exit 1
        ;;
    esac
    shift
done

case $strategy in
auto | merge | rebuild) ;;
*)
    echobad "--strategy must be auto, merge or rebuild (got: $strategy)"
    exit 1
    ;;
esac

############################################ HELP

# What sake-llm-opencode will really use (its own default / LLM_* env / our -m and --provider).
effective_model() {
    local args=(--help) out
    [[ -n "$provider" ]] && args+=(--provider "$provider")
    [[ -n "$model" ]] && args+=(--model "$model")
    out=$(sake-llm-opencode "${args[@]}" 2>&1 | sed 's/\x1b\[[0-9;]*m//g')
    printf '%s\n' "$out" | grep -E '^ *(provider|model|variant) \(override/env/default\):' | sed 's/ (override\/env\/default)//; s/^ */   /'
}

help_and_exit() {
    ECHOHEAD "Bring SS5 work (branch $sourceBranch) into the SS6 branch (main) across all repos"
    echonice "$SCRIPT_SUMMARY"
    echonice ""
    echonice "directory of script:           $SCRIPT_DIR"

    ECHOHEAD "Current settings:"
    echonice "owner:                         $owner"
    echonice "source branch (-s):            $sourceBranch  (stays SS5)"
    echonice "base branch (-b):              ${baseBranch:-(repo default branch)}  (SS6)"
    echonice "strategy (--strategy):         $strategy  (conflict limit: $conflictLimit, main work limit: $mainWorkLimit)"
    echonice "rector prep before merge:      $prep"
    echonice "upgrade command (rebuild):     ${upgradeCmd:-(none: Rector + LLM do the upgrade)}"
    echonice "work dir (-w):                 $workDir"
    echonice "rector config (-r):            $rectorConfig"
    echonice "skip repos (--skip):           ${skip:-(none)}"
    echonice "ask per repo:                  $([[ "$assumeYes" == 'yes' ]] && echo no || echo 'yes (when interactive)')"
    echonice "changelog first:               $runChangelog"
    echonice "verify install + tests:        $verifyInstall (soft: $verifySoft)"
    echonice "use LLM:                       $useLlm"
    echonice "LLM that WILL be used (no -m needed; override with -m/--provider or LLM_MODEL/LLM_PROVIDER):"
    while IFS= read -r l; do echonice "$l"; done < <(effective_model)
    echonice "max LLM spend (--max-cost):    ${maxCost:-(no limit)}"
    echonice "push to base:                  $push"
    echonice "pull request mode (--pr):      $prMode (branch: $prBranch, draft: $prDraft)"
    echonice "dry run:                       $dryRun"

    ECHOHEAD "The idea in one go:"
    echonice "1. MEASURE   how many files would conflict, and how much real (non-upgrade) work main has since 5 and main split."
    echonice "2. MERGE     (most repos) run Rector on scratch copies of 5 and of the point where 5 and main split, then merge"
    echonice "             against that. The mechanical SS6 changes then match everywhere, so only real conflicts are left for the LLM."
    echonice "3. REBUILD   (repos where 2 still conflicts a lot and main has little own work) start main again from 5:"
    echonice "             upgrade that copy to SS6, copy main's own commits across, and record the old main with 'merge -s ours'"
    echonice "             (old main stays in the history, no force push, no renamed branches). An LLM then checks nothing"
    echonice "             from the old main was lost."
    echonice "4. HUMAN     (lots of conflicts AND lots of own work on main) reported, not touched."
    echonice "Branch $sourceBranch itself only ever gets the CHANGELOG.md commit; all SS6 work lands on main (or the PR branch)."

    ECHOHEAD "What it does per repo:"
    echonice "0. skips repos without a '$sourceBranch' branch, or where it is not ahead of the base branch; prints the measurements"
    echonice "   asks [p]roceed / [s]kip / [q]uit (not with --yes, --dry-run or without a terminal)"
    echonice "1. runs sake-git-merge-towards-production-changes on '$sourceBranch' (CHANGELOG.md)"
    echonice "2. merge path: (a) Rector on scratch copies of '$sourceBranch' and the merge base (b) merge (c) LLM resolves conflicts"
    echonice "   (composer.json keeps the base version) (d) LLM reviews the whole incoming diff, then the merge is committed"
    echonice "   rebuild path: (a) copy of '$sourceBranch' + base composer.json + Rector (+ --upgrade-cmd) (b) cherry-pick base's own"
    echonice "   commits (c) 'git merge -s ours origin/<base>' (d) LLM compares with the old base and brings back what is missing"
    echonice "3. sake-lint-php-rector -r $rectorConfig, an LLM SS6 clean-up, then checks:"
    echonice "   composer validate + php -l on all PHP files (one LLM repair attempt if it fails)"
    echonice "   with --verify-install also: composer install/update + vendor/bin/phpunit in a scratch copy (repo itself stays clean)"
    echonice "   tests need the DB env your Silverstripe tests normally use (SS_DATABASE_* ...) in your shell"
    echonice "PR mode (--pr): all work happens on branch '$prBranch' and a pull request into the base branch is opened."
    echonice "   The base branch and '$sourceBranch' are NEVER pushed. Repos that already have that branch on origin are skipped"
    echonice "   (safe to re-run); --force-pr rebuilds it."
    echonice "4. commits the clean-up (and pushes with --push) using sake-git-commit-and-push"
    echonice "   a failing repo is reset to where it started and reported, never left half-merged"

    ECHOHEAD "Available settings:"
    echonice "-o, --owner OWNER              GitHub user or org (default: sunnysideup)"
    echonice "-l, --limit NUMBER             max repos to scan (default: 1000)"
    echonice "-s, --source BRANCH            branch to take work FROM (default: 5)"
    echonice "-b, --base BRANCH              branch to bring work INTO (default: repo default branch)"
    echonice "    --strategy auto|merge|rebuild   auto (default) measures and picks; merge / rebuild force one path"
    echonice "    --no-prep                  merge path: do not run Rector on copies of the source branch / merge base before merging"
    echonice "    --conflict-limit N         auto: more conflicted files than this after the prep = do not merge (default $conflictLimit)"
    echonice "    --main-work-limit N        auto: rebuild only if base has at most N own commits since the split (default $mainWorkLimit)"
    echonice "    --upgrade-cmd 'CMD'        rebuild path: your own SS6 upgrade command, run in the repo after Rector"
    echonice "                               (env: SAKE_REPO, SAKE_BASE_BRANCH, SAKE_SOURCE_BRANCH)"
    echonice "    --upgrade-regex REGEX      commit subjects on base that count as upgrade work, not features"
    echonice "-w, --work-dir DIR             where repos are cloned (default: $workDir)"
    echonice "-r, --rector-config NAME       rector config (default: SS62)"
    echonice "    --only a,b,c               only these repo names (prefixes 'sunnysideup-' and 'silverstripe-' are optional: 'ecommerce' = 'silverstripe-ecommerce')"
    echonice "    --skip a,b,c               never touch these repo names (same matching as --only)"
    echonice "-y, --yes                      do not ask per repo (automation)"
    echonice "    --no-changelog             do not run sake-git-merge-towards-production-changes first"
    echonice "-d, --dry-run                  only measure and report what would happen per repo"
    echonice "    --pr                       open a pull request per repo instead of changing the base branch"
    echonice "    --pr-branch NAME           PR branch name (default: upgrade/ss6-merge-5)"
    echonice "    --no-draft                 open PRs as ready for review (default: draft)"
    echonice "    --force-pr                 rebuild a PR branch that already exists (force-with-lease)"
    echonice "-p, --push                     push the result (commit goes through sake-git-commit-and-push)"
    echonice "    --no-llm                   skip all LLM steps (conflicts then fail the repo)"
    echonice "    --provider PROVIDER        LLM provider (passed to sake-llm-opencode)"
    echonice "-m, --model MODEL              LLM model (passed to sake-llm-opencode)"
    echonice "    --verify-install           composer install + PHPUnit in a scratch copy (SS6 deps resolved for real); failure = repo fails"
    echonice "    --verify-soft              with --verify-install: do not fail the repo, record the result in the PR/summary instead"
    echonice "    --max-cost USD             stop (after the current step) once total LLM spend reaches USD"
    echonice "    --conflict-batch N         max conflicted files per LLM call (default $conflictBatch; files are grouped per folder; 1 = one call per file)"
    echonice "    --thinking                 show the model's thinking while it works"
    echonice "-v, --verbose                  show skipped repos too"
    echonice ""
    echonice "While the LLM works its output streams live. Ctrl-C stops the LLM step only, then asks:"
    echonice "[s]kip this repo (reset, nothing pushed) / [c]ontinue with what it did so far / [q]uit"
    echonice "Cost per LLM call, per repo and in total is printed (needs jq)."
    echonice "-h, --help                     show help information"

    ECHOHEAD "Example usage:"
    echonice "sake-git-upgrade-5-to-6-all --dry-run                   # measure all repos, see merge / rebuild / human per repo"
    echonice "sake-git-upgrade-5-to-6-all --only silverstripe-seo --skip silverstripe-email-helpers -m github-copilot/claude-sonnet-4.5"
    echonice "sake-git-upgrade-5-to-6-all --pr --yes                  # a draft PR per repo to review on GitHub"
    echonice "sake-git-upgrade-5-to-6-all --pr --only ecommerce --strategy rebuild"
    echonice "sake-git-upgrade-5-to-6-all --push"

    echofunctions
    exit
}

sake_check_help_and_exit

############################################ PROMPTS

write_prompts() {
    local dir=$1
    mkdir -p "$dir/.agents"

    cat >"$dir/.agents/prompt-conflicts.txt" <<TXT
You are resolving a git merge conflict in a Silverstripe module.
Branch '$sourceBranch' (Silverstripe CMS 5, already run through Rector for SS6) is being merged into '$base' (Silverstripe CMS 6, PHP 8.3+).
In the attached file(s), resolve every conflict marker (<<<<<<<, =======, >>>>>>>).
- Keep shared feature and bug-fix content from both sides.
- Prefer the Silverstripe 6 compatible form; drop SS5-only plumbing.
- Never leave conflict markers behind. Do not run git commands. Do not commit.
- Only edit the attached file(s).
TXT

    cat >"$dir/.agents/prompt-review.txt" <<TXT
Branch '$sourceBranch' (Silverstripe CMS 5) has just been merged (uncommitted) into '$base' (Silverstripe CMS 6, PHP 8.3+)
in this Silverstripe module. The attached file merge.diff is the complete incoming change set relative to '$base'
(git diff --cached HEAD). Review ALL of it, including changes that merged silently:
- Keep feature work and bug fixes that are valid for SS6.
- Revert anything that is not required or is wrong on '$base': SS5-only class names/APIs, PHP 8.1/8.2-only plumbing,
  SS5 dependency constraints, SS5-only workarounds, downgrades of code that '$base' already has in newer form.
  To revert a file or hunk, edit it back to its '$base' content (you may run: git show HEAD:<path>).
- composer.json must keep the '$base' version, BUT if '$sourceBranch' added a new dependency that the new code needs,
  add its SS6 compatible version to composer.json (check with: git show $sourceBranch:composer.json).
- You may run read-only git commands (git diff, git show, git status). Do NOT run git add, commit, checkout, reset or merge.
- No conflict markers may remain.
TXT

    cat >"$dir/.agents/prompt-lost.txt" <<TXT
The '$base' branch of this Silverstripe module is being rebuilt. Branch '$sourceBranch' (Silverstripe CMS 5) has more recent
work than the old '$base' (Silverstripe CMS 6), so the code now in the working tree is '$sourceBranch' plus Rector ($rectorConfig)
and the own commits of the old '$base' that could be copied across automatically. It must end up working on SS6 / PHP 8.3.
The attached lost.diff is 'git diff HEAD origin/$base': lines starting with '+' exist in the old '$base' but not in the working tree.
Use it for two things:
1. SS6 upgrade: the old '$base' shows how this module was upgraded to SS6 before. Apply the same SS6 changes (class names,
   namespaces, APIs, config, templates, composer constraints) to the current code where they are still missing.
2. Lost work: find features and bug fixes that exist only in the old '$base' and are still needed, and add them.
Do NOT bring back code that '$sourceBranch' deliberately changed or removed later. When unsure, leave it and write one line about it
in .agents/lost-notes.md (it is shown to the reviewer).
You may run read-only git commands (git diff, git show, git log). Do NOT run git add, commit, checkout, reset, merge or cherry-pick.
No conflict markers may remain.
TXT

    cat >"$dir/.agents/prompt-cleanup.txt" <<TXT
This Silverstripe module's '$base' branch now contains the work from its Silverstripe CMS 5 branch ('$sourceBranch'),
and Rector ($rectorConfig) has already run. Make sure the module works with Silverstripe CMS 6 / PHP 8.3:
- composer.json: require silverstripe/framework (and other silverstripe/* and sunnysideup/* modules) in their SS6 compatible
  constraints (^6 or the SS6 version of that package), PHP ^8.3, and remove SS5-only constraints.
- Replace any remaining SS5 class names, removed or deprecated APIs and SS5-only syntax with the SS6 equivalents.
- Check src/, tests/, templates/, _config/ (yml) and client/ for SS5 leftovers.
- No conflict markers (<<<<<<<, =======, >>>>>>>) may remain anywhere.
- Keep changes minimal and do not change behaviour. Do not run git commands. Do not commit.
TXT
}

# Cost tracking: sake-llm-opencode appends "cost tokensIn tokensOut" per call to this file.
export SAKE_LLM_COST_FILE="$(mktemp "${TMPDIR:-/tmp}/sake-llm-cost.XXXXXX")"
trap 'rm -f "$SAKE_LLM_COST_FILE"' EXIT

total_cost() { awk '{c+=$1} END {printf "%.4f", c+0}' "$SAKE_LLM_COST_FILE"; }
total_tokens() { awk '{i+=$2; o+=$3} END {printf "%d in / %d out", i, o}' "$SAKE_LLM_COST_FILE"; }
over_budget() { [[ -n "$maxCost" ]] && awk -v t="$(total_cost)" -v m="$maxCost" 'BEGIN {exit !(t+0 >= m+0)}'; }

ABORT_REPO='no'
IN_LLM='no'

# Ctrl-C: during an LLM call only the LLM is stopped (we then ask what to do); otherwise abort cleanly.
on_int() {
    [[ "$IN_LLM" == 'yes' ]] && return 0
    echo
    echowarn "interrupted: restoring the current repo and stopping"
    cd "${CURRENT_DIR:-.}" 2>/dev/null && bail
    echonice "LLM spend so far: \$$(total_cost) ($(total_tokens))"
    exit 130
}
trap on_int INT

# run_llm PROMPT_FILE FILES_GLOB   (output streams live; sets ABORT_REPO if the user stops the repo)
run_llm() {
    local promptFile=$1 files=$2 rc ans
    if over_budget; then
        echobad "LLM budget reached (\$$(total_cost) >= \$$maxCost): stopping"
        ABORT_REPO='yes'
        QUIT='yes'
        return 1
    fi
    local args=(".")
    args+=(--files "$files" --prompt "$promptFile")
    [[ -n "$provider" ]] && args+=(--provider "$provider")
    [[ -n "$model" ]] && args+=(--model "$model")
    [[ "$thinking" == 'yes' ]] && args+=(--thinking)

    IN_LLM='yes'
    sake-llm-opencode "${args[@]}"
    rc=$?
    IN_LLM='no'

    echonice "LLM spend so far: \$$(total_cost) ($(total_tokens))${maxCost:+ of max \$$maxCost}"
    if ((rc == 130)); then
        echo
        if [[ -t 0 ]]; then
            while true; do
                read -r -p "   LLM stopped. [s]kip this repo / [c]ontinue with what it did / [q]uit: " ans </dev/tty
                case "${ans,,}" in
                s | skip)
                    ABORT_REPO='yes'
                    break
                    ;;
                c | continue) break ;;
                q | quit)
                    ABORT_REPO='yes'
                    QUIT='yes'
                    break
                    ;;
                esac
            done
        else
            ABORT_REPO='yes'
        fi
    fi
    return $rc
}

# after an LLM step: if the user stopped the repo, restore it
aborted() {
    [[ "$ABORT_REPO" == 'yes' ]] || return 1
    echowarn "stopped by user: restoring repo"
    bail
    return 0
}

############################################ MEASURING

QUIT='no'
START_SHA=''
PR_URLS=()
VERIFY_DETAIL=''
STEPS_DONE=()   # what happened to this repo (used in the PR body)
REPO_NOTE=''    # why a repo was left for a human
PATH_USED=''    # merge | rebuild
PREP_SHA=''     # Rector commit on top of the source branch ('' = Rector changed nothing)
PREP_TIP=''     # source branch + Rector (detached commit, never on a branch, never pushed)
PREP_BASE=''    # merge base + Rector    (detached commit, never on a branch, never pushed)
REMERGED=0
CHANGELOG_DONE='no'

merge_in_progress() { git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; }
unmerged_paths() { git diff --name-only --diff-filter=U; }

markers_remaining() {
    git grep -lEI '^(<{7} |={7}$|>{7} )' -- . ':!*.md' 2>/dev/null
}

# Number of files that would conflict when merging $2 into $1, optionally against merge base $3
# (nothing is touched; needs git >= 2.40).
conflict_count() {
    local args=(--write-tree --name-only --no-messages)
    [[ -n "${3:-}" ]] && args+=(--merge-base="$3")
    git merge-tree "${args[@]}" "$1" "$2" 2>/dev/null | tail -n +2 | grep -c .
}

# Commits on origin/$base since the split that are real work, not upgrade/maintenance (oldest first).
own_base_commits() {
    local mb=$1 h s
    git log --reverse --no-merges --format='%H%x09%s' "$mb..origin/$base" | while IFS=$'\t' read -r h s; do
        grep -Eiq -- "$upgradeRegex" <<<"$s" || echo "$h"
    done
}

# Cheap measurements on the remote branches. Sets A_MB, A_CONFLICTS, A_OWN and A_LINE.
assess_repo() {
    local src="origin/$sourceBranch" dst="origin/$base" srcN dstN both
    A_MB=$(git merge-base "$dst" "$src" 2>/dev/null)
    if [[ -z "$A_MB" ]]; then
        A_CONFLICTS=999 A_OWN=0
        A_LINE="no common history between '$sourceBranch' and '$base'"
        return
    fi
    srcN=$(git diff --name-only "$A_MB" "$src" | grep -c .)
    dstN=$(git diff --name-only "$A_MB" "$dst" | grep -c .)
    both=$(comm -12 <(git diff --name-only "$A_MB" "$src" | sort) <(git diff --name-only "$A_MB" "$dst" | sort) | grep -c .)
    A_CONFLICTS=$(conflict_count "$dst" "$src")
    A_OWN=$(own_base_commits "$A_MB" | grep -c .)
    A_LINE="files changed since split: $sourceBranch $srcN, $base $dstN, both $both | conflicts (plain merge): $A_CONFLICTS | own $base commits: $A_OWN"
}

suggest_strategy() {
    case $strategy in
    merge | rebuild)
        echo "$strategy (forced)"
        return
        ;;
    esac
    if [[ -z "$A_MB" ]]; then
        echo 'rebuild (no common history)'
    elif ((A_CONFLICTS <= conflictLimit)); then
        echo 'merge'
    elif ((A_OWN <= mainWorkLimit)); then
        echo "merge if the Rector prep gets conflicts down to <= $conflictLimit, otherwise rebuild"
    else
        echo "merge if the Rector prep gets conflicts down to <= $conflictLimit, otherwise needs a human"
    fi
}

############################################ PER REPO

# Put the clone back exactly where this repo's run started.
bail() {
    merge_in_progress && git merge --abort >/dev/null 2>&1
    git rev-parse -q --verify CHERRY_PICK_HEAD >/dev/null 2>&1 && git cherry-pick --abort >/dev/null 2>&1
    [[ -n "$START_SHA" ]] && git reset --hard "$START_SHA" >/dev/null 2>&1
    git clean -fd -e .agents >/dev/null 2>&1
    return 1
}

php_dirs() {
    local d
    for d in src code app/src tests; do [[ -d "$d" ]] && echo "$d"; done
}

run_rector() {
    local d any='no'
    for d in $(php_dirs); do
        any='yes'
        sake-lint-php-rector -r "$rectorConfig" -a _config.php "$d" || return 1
    done
    [[ "$any" == 'yes' ]] || echowarn "no src/code/tests dir found, rector skipped"
    return 0
}

# Cheap "does it still hang together" checks. Writes problems to .agents/verify.txt.
verify_module() {
    local out=.agents/verify.txt f rc=0
    : >"$out"

    if command -v composer >/dev/null 2>&1 && [[ -f composer.json ]]; then
        composer validate --no-check-publish --no-check-all >>"$out" 2>&1 || {
            echo "composer validate FAILED" >>"$out"
            rc=1
        }
    fi
    if command -v php >/dev/null 2>&1; then
        while IFS= read -r f; do
            php -l "$f" >/dev/null 2>>"$out" || {
                echo "php -l FAILED: $f" >>"$out"
                rc=1
            }
        done < <(git ls-files '*.php')
    fi
    if [[ -n "$(markers_remaining)" ]]; then
        echo "conflict markers remain in: $(markers_remaining | tr '\n' ' ')" >>"$out"
        rc=1
    fi
    return $rc
}

# composer install + phpunit in a scratch copy so vendor/ and composer.lock never end up in the repo.
# Appends to .agents/verify.txt. rc 0 = passed (or no tests to run), 1 = failed.
verify_install() {
    local out="$PWD/.agents/verify.txt" tmp rc=0
    local installLog testLog
    command -v composer >/dev/null 2>&1 || {
        echo "composer not installed; cannot verify install" >>"$out"
        return 1
    }

    tmp=$(mktemp -d "${TMPDIR:-/tmp}/ss6-verify.XXXXXX") || return 1
    git ls-files -co --exclude-standard -z | xargs -0 -r cp --parents -t "$tmp" 2>/dev/null

    installLog="$tmp/.composer.log"
    testLog="$tmp/.phpunit.log"

    echonice "composer install in scratch copy (this resolves SS6 dependencies)..."
    if [[ -f "$tmp/composer.lock" ]]; then
        (cd "$tmp" && timeout "$VERIFY_TIMEOUT" composer install --no-interaction --no-progress --prefer-dist) >"$installLog" 2>&1 || rc=1
    else
        (cd "$tmp" && timeout "$VERIFY_TIMEOUT" composer update --no-interaction --no-progress --prefer-dist) >"$installLog" 2>&1 || rc=1
    fi
    if ((rc != 0)); then
        {
            echo "composer install FAILED (last 60 lines):"
            tail -n 60 "$installLog"
        } >>"$out"
        rm -rf "$tmp"
        return 1
    fi

    if [[ -x "$tmp/vendor/bin/phpunit" ]] && ls "$tmp"/phpunit.xml* >/dev/null 2>&1; then
        echonice "running phpunit in scratch copy..."
        (cd "$tmp" && SS_ENVIRONMENT_TYPE="${SS_ENVIRONMENT_TYPE:-dev}" timeout "$VERIFY_TIMEOUT" vendor/bin/phpunit) >"$testLog" 2>&1 || rc=1
        if ((rc != 0)); then
            {
                echo "phpunit FAILED (last 80 lines):"
                tail -n 80 "$testLog"
            } >>"$out"
        else
            echonice "$(tail -n 3 "$testLog" | tr '\n' ' ')"
        fi
    else
        echonice "no phpunit binary/config: install verified, no tests to run"
        VERIFY_SUMMARY='composer install resolved SS6 dependencies; no PHPUnit config, so no tests were run'
        rm -rf "$tmp"
        return 0
    fi

    rm -rf "$tmp"
    ((rc == 0)) && VERIFY_SUMMARY='composer install resolved SS6 dependencies and PHPUnit passed (in a scratch copy)'
    return $rc
}

# static checks, then (optionally) the heavier install + tests
verify_all() {
    verify_module || return 1
    [[ "$verifyInstall" == 'yes' ]] || return 0
    verify_install
}

ask_repo() {
    local name=$1 ans
    [[ "$assumeYes" == 'yes' || "$dryRun" == 'yes' || ! -t 0 ]] && return 0
    while true; do
        read -r -p "   upgrade $name? [p]roceed / [s]kip / [q]uit: " ans </dev/tty
        case "${ans,,}" in
        p | proceed | y | yes | '') return 0 ;;
        s | skip | n | no) return 1 ;;
        q | quit)
            echowarn "quitting."
            QUIT='yes'
            return 1
            ;;
        esac
    done
}

# Update CHANGELOG.md on the source branch (commits there) before its work is brought across. Runs once per repo.
changelog_on_source() {
    local repo=$1
    [[ "$CHANGELOG_DONE" == 'yes' ]] && return 0
    CHANGELOG_DONE='yes'
    git checkout -q -B "$sourceBranch" "origin/$sourceBranch" || return 1
    [[ "$runChangelog" == 'yes' && "$useLlm" == 'yes' ]] || return 0

    ECHOHEAD "$repo: CHANGELOG.md on $sourceBranch"
    local args=(. -b "$sourceBranch" --no-fetch)
    [[ -n "$provider" ]] && args+=(--provider "$provider")
    [[ -n "$model" ]] && args+=(--model "$model")
    if ! sake-git-merge-towards-production-changes "${args[@]}"; then
        echowarn "$repo: changelog step failed; continuing without it"
        git reset -q --hard "origin/$sourceBranch" 2>/dev/null
        git clean -fdq -e .agents
    else
        STEPS_DONE+=("CHANGELOG.md updated on \`$sourceBranch\` (that commit is the only change to \`$sourceBranch\`)")
    fi
    return 0
}

# rector_commit START: detached HEAD at START + base composer.json + Rector, committed if anything changed.
rector_commit() {
    local start=$1
    git checkout -q --detach "$start" || return 1
    git cat-file -e "origin/$base:composer.json" 2>/dev/null && git checkout "origin/$base" -- composer.json
    if ! run_rector; then
        echowarn "Rector on $(git rev-parse --short "$start") failed: no prep"
        git reset -q --hard "$start"
        git clean -fdq -e .agents
        return 1
    fi
    git add -A
    git diff --cached --quiet || git commit -q -m "MNT: Rector $rectorConfig (and '$base' composer.json) before merging into '$base'"
}

# The prep: apply the same mechanical SS6 upgrade (Rector + base composer.json) to BOTH the source branch and the merge base.
# Merging against that Rector'd merge base, changes both sides made the same way drop out; only real conflicts remain.
# Sets PREP_BASE, PREP_TIP and PREP_SHA (all detached commits: no branches are created, nothing is pushed).
prepare_source() {
    local start=$1 mb
    PREP_TIP='' PREP_SHA='' PREP_BASE=''
    mb=$(git merge-base "origin/$base" "origin/$sourceBranch" 2>/dev/null) || return 1
    rector_commit "$mb" || return 1
    PREP_BASE=$(git rev-parse HEAD)
    if ! rector_commit "$start"; then
        PREP_BASE=''
        return 1
    fi
    PREP_TIP=$(git rev-parse HEAD)
    [[ "$PREP_TIP" != "$(git rev-parse "$start^{commit}")" ]] && PREP_SHA=$PREP_TIP
    return 0
}

# Redo the 3-way merge of every conflicted file against the Rector'd merge base (PREP_BASE).
# Clean results are staged; the rest keep (smaller) conflict markers for the LLM. Sets REMERGED.
remerge_with_prepped_base() {
    local f o b t rc files
    REMERGED=0
    [[ -n "$PREP_BASE" ]] || return 0
    o=$(mktemp) b=$(mktemp) t=$(mktemp)
    mapfile -t files < <(unmerged_paths)
    for f in "${files[@]}"; do
        git show ":2:$f" >"$o" 2>/dev/null && git show "$PREP_BASE:$f" >"$b" 2>/dev/null && git show ":3:$f" >"$t" 2>/dev/null || continue
        git merge-file -q -L "$base" -L "merge base (Rector'd)" -L "$sourceBranch" "$o" "$b" "$t"
        rc=$?
        ((rc < 128)) || continue # error (binary file ...): keep git's own conflict
        cp "$o" "$f"
        if ((rc == 0)); then
            git add -- "$f"
            REMERGED=$((REMERGED + 1))
        fi
    done
    rm -f "$o" "$b" "$t"
    echonice "$REMERGED of ${#files[@]} conflicted file(s) merged cleanly against the Rector'd merge base"
}

# Branch all work happens on: the PR branch, or base itself.
work_branch() {
    if [[ "$prMode" == 'yes' ]]; then echo "$prBranch"; else echo "$base"; fi
}

# Push the PR branch and open a pull request into base. Never touches base or the source branch on origin.
open_pull_request() {
    local repo=$1 body=.agents/pr-body.md pushArgs=(-u) i
    [[ "$forcePr" == 'yes' ]] && pushArgs+=(--force-with-lease)

    {
        echo "## Upgrade to Silverstripe 6"
        echo
        echo "Automated by \`sake-git-upgrade-5-to-6-all\` ($PATH_USED path): brings the SS5 work from \`$sourceBranch\` into \`$base\` (SS6)."
        echo "\`$sourceBranch\` stays on Silverstripe 5."
        echo
        echo "### What was done"
        for i in "${!STEPS_DONE[@]}"; do echo "$((i + 1)). ${STEPS_DONE[$i]}"; done
        if [[ -n "$VERIFY_DETAIL" ]]; then
            echo
            echo '<details><summary>Failure output</summary>'
            echo
            echo '```'
            echo "$VERIFY_DETAIL"
            echo '```'
            echo '</details>'
        fi
        if [[ -s .agents/lost-notes.md ]]; then
            echo
            echo "### Left out on purpose / unsure (from the old \`$base\`)"
            cat .agents/lost-notes.md
        fi
        echo
        echo "### Commits"
        git log --no-merges --oneline "origin/$base..HEAD" | head -n 60 | sed 's/^/- /'
        echo
        echo "### Files changed"
        echo '```'
        git diff --stat "origin/$base"...HEAD | tail -n 40
        echo '```'
        echo
        echo "### Please review"
        echo "- [ ] No SS5-only code, class names or constraints came across"
        echo "- [ ] \`composer.json\` constraints are right for SS6"
        echo "- [ ] Tests pass in CI / a real SS6 project (see the verification line above for what the script actually ran)"
        echo "- [ ] LLM edits (conflict resolution, clean-up) look sensible"
        [[ "$PATH_USED" == 'rebuild' ]] && echo "- [ ] Nothing from the old \`$base\` is missing (compare with its last commit: \`git diff HEAD^2 HEAD\` on the rebuild merge)"
    } >"$body"

    git push "${pushArgs[@]}" origin "$prBranch" || {
        echobad "$repo: could not push $prBranch"
        return 1
    }

    local prArgs=(pr create --repo "$owner/$repo" --base "$base" --head "$prBranch"
        --title "Upgrade to Silverstripe 6 ($PATH_USED: $sourceBranch into $base)" --body-file "$body")
    [[ "$prDraft" == 'yes' ]] && prArgs+=(--draft)
    local url
    if url=$(gh "${prArgs[@]}" 2>&1 | tail -n1); then
        echogood "$repo: pull request: $url"
        PR_URLS+=("$repo $url")
        return 0
    fi
    echobad "$repo: branch pushed but PR creation failed: $url"
    echonice "  create it by hand: gh pr create --repo $owner/$repo --base $base --head $prBranch"
    return 1
}

############ MERGE path: merge (a Rector'd copy of) the source branch into base
merge_path() {
    local repo=$1 from=$2 f
    PATH_USED='merge'
    git checkout -q -B "$(work_branch)" "origin/$base" || return 1
    START_SHA=$(git rev-parse HEAD)

    [[ -n "$PREP_BASE" ]] &&
        STEPS_DONE+=("Rector (\`$rectorConfig\`) run on scratch copies of \`$sourceBranch\` and of the merge base first, so the mechanical SS6 changes match \`$base\` and merge cleanly")

    ############ (a) merge
    ECHOHEAD "$repo: merging $sourceBranch into $base"
    git merge --no-ff --no-commit "$from" >/dev/null 2>&1

    if ! merge_in_progress; then
        echonice "$repo: nothing to merge"
        return 0
    fi

    # composer.json is version specific: always keep the base branch version (the review step adds new dependencies)
    if unmerged_paths | grep -qx 'composer.json'; then
        git checkout --ours composer.json 2>/dev/null && git add composer.json
    fi

    # mechanical SS6 differences drop out when merging against the Rector'd merge base
    [[ -n "$(unmerged_paths)" ]] && remerge_with_prepped_base

    ############ (b) conflicts
    local n_total=0
    if [[ -n "$(unmerged_paths)" ]]; then
        if [[ "$useLlm" != 'yes' ]]; then
            echobad "conflicts in: $(unmerged_paths | tr '\n' ' ') (and --no-llm given)"
            bail
            return 1
        fi
        local salvageDir salvageKey n_done=0 n_reused=0
        salvageDir="$(realpath -m "$workDir")/.salvage/$repo"
        # keyed on the remote branches (not the local changelog commit, which is new on every run)
        salvageKey="$(git rev-parse "origin/$base") $(git rev-parse "origin/$sourceBranch") prep=$([[ -n "$PREP_BASE" ]] && echo yes || echo no) $rectorConfig"
        if [[ "$(cat "$salvageDir/.key" 2>/dev/null)" != "$salvageKey" ]]; then
            rm -rf "$salvageDir"
        fi
        mkdir -p "$salvageDir" && printf '%s' "$salvageKey" >"$salvageDir/.key"

        n_total=$(unmerged_paths | wc -l)
        local pending todo=()
        mapfile -t pending < <(unmerged_paths)

        for f in "${pending[@]}"; do
            if [[ -f "$salvageDir/files/$f" ]]; then
                cp "$salvageDir/files/$f" "$f"
                echogood "reusing earlier LLM resolution (free): $f"
                n_reused=$((n_reused + 1))
            else
                todo+=("$f")
            fi
        done

        # keep every file the LLM resolved, even when this run is later stopped (budget, Ctrl-C, failure)
        salvage_resolved() {
            local x
            for x in "$@"; do
                if [[ -f "$x" ]] && ! grep -qE '^(<{7} |={7}$|>{7} )' "$x"; then
                    mkdir -p "$salvageDir/files/$(dirname "$x")" && cp "$x" "$salvageDir/files/$x"
                    n_done=$((n_done + 1))
                fi
            done
        }
        stop_message() {
            [[ "$ABORT_REPO" == 'yes' ]] || return 0
            echowarn "$repo: stopped. Saved $((n_done + n_reused)) of $n_total resolved conflict file(s) in $salvageDir/files"
            echonice "   re-run the same command (raise --max-cost if that was the reason): saved files are reused at no LLM cost"
        }

        # group files per folder (similar conflicts in one folder are resolved consistently in one call), capped by file count and size:
        # every call has a fixed overhead, but a huge call re-reads its whole context at every step
        ((conflictBatch >= 1)) || conflictBatch=1
        local batches=() cur='' curN=0 curBytes=0 curDir='' sz d b batchFiles
        for f in "${todo[@]}"; do
            sz=$(stat -c %s "$f" 2>/dev/null || echo 0)
            d=$(dirname "$f")
            if ((curN > 0)) && { ((curN >= conflictBatch)) || ((curBytes + sz > conflictBytes)) || { [[ "$d" != "$curDir" ]] && ((curN >= 3)); }; }; then
                batches+=("$cur")
                cur='' curN=0 curBytes=0
            fi
            cur+="${cur:+$'\n'}$f"
            curN=$((curN + 1))
            curBytes=$((curBytes + sz))
            curDir=$d
        done
        ((curN > 0)) && batches+=("$cur")
        echonice "$repo: ${#todo[@]} file(s) to resolve in ${#batches[@]} LLM call(s)"

        for b in "${batches[@]}"; do
            mapfile -t batchFiles <<<"$b"
            echonice "cleaning up conflicts with LLM (${#batchFiles[@]} file(s)): ${batchFiles[*]}"
            run_llm "$PWD/.agents/prompt-conflicts.txt" "$b" || echowarn "LLM exited non-zero for this batch"
            salvage_resolved "${batchFiles[@]}"
            stop_message
            aborted && return 1
        done

        # whatever a batch left unresolved gets one more try on its own
        for f in "${todo[@]}"; do
            [[ -f "$salvageDir/files/$f" ]] && continue
            echowarn "$f still has conflict markers: retrying on its own"
            run_llm "$PWD/.agents/prompt-conflicts.txt" "$f" || echowarn "LLM exited non-zero for $f"
            salvage_resolved "$f"
            stop_message
            aborted && return 1
        done
        if [[ -n "$(markers_remaining)" ]]; then
            echobad "conflict markers remain in: $(markers_remaining | tr '\n' ' ')"
            bail
            return 1
        fi
    fi
    git add -A
    STEPS_DONE+=("\`$sourceBranch\` merged into \`$base\`; $REMERGED file(s) merged cleanly thanks to the prep, $n_total conflicted file(s) resolved by the LLM (\`composer.json\` keeps the \`$base\` version)")

    ############ (c) review the whole incoming change set
    if [[ "$useLlm" == 'yes' ]]; then
        ECHOHEAD "$repo: LLM review of incoming changes"
        git diff --cached HEAD >.agents/merge.diff
        run_llm "$PWD/.agents/prompt-review.txt" '.agents/merge.diff' || echowarn "LLM review exited non-zero"
        aborted && return 1
        if [[ -n "$(markers_remaining)" ]]; then
            echobad "conflict markers remain in: $(markers_remaining | tr '\n' ' ')"
            bail
            return 1
        fi
        git add -A
        STEPS_DONE+=("LLM review of the whole incoming diff, reverting changes not needed on SS6")
    fi

    git commit -q --no-edit -m "Merge branch '$sourceBranch' into $base" || {
        bail
        return 1
    }
    echogood "$repo: merge committed"
    finish_ss6 "$repo"
}

############ REBUILD path: start again from the source branch, upgrade it, keep the old base in the history
rebuild_path() {
    local repo=$1 mb h ported=0 notPorted=()
    PATH_USED='rebuild'
    changelog_on_source "$repo" || return 1

    ECHOHEAD "$repo: rebuilding $base from $sourceBranch"
    # the work branch starts at the source branch; the source branch itself is not changed
    git checkout -q -B "$(work_branch)" "$sourceBranch" || return 1
    START_SHA=$(git rev-parse HEAD)

    ############ (a) SS6 starting point: base composer.json + Rector (+ your own upgrade command)
    git cat-file -e "origin/$base:composer.json" 2>/dev/null && git checkout "origin/$base" -- composer.json
    if ! run_rector; then
        echobad "rector failed"
        bail
        return 1
    fi
    if [[ -n "$upgradeCmd" ]]; then
        echonice "running upgrade command: $upgradeCmd"
        if ! SAKE_REPO="$repo" SAKE_BASE_BRANCH="$base" SAKE_SOURCE_BRANCH="$sourceBranch" bash -c "$upgradeCmd"; then
            echobad "$repo: upgrade command failed"
            bail
            return 1
        fi
    fi
    git add -A
    git diff --cached --quiet || git commit -q -m "API: upgrade '$sourceBranch' code to Silverstripe 6 (Rector $rectorConfig, composer.json from '$base')"
    STEPS_DONE+=("Started from \`$sourceBranch\`: \`composer.json\` taken from \`$base\`, Rector (\`$rectorConfig\`)${upgradeCmd:+ and \`$upgradeCmd\`} run")

    ############ (b) copy base's own commits (features / fixes made on SS6 only)
    mb=$(git merge-base "origin/$base" "origin/$sourceBranch" 2>/dev/null)
    if [[ -n "$mb" ]]; then
        while IFS= read -r h; do
            [[ -n "$h" ]] || continue
            if git cherry-pick -x "$h" >/dev/null 2>&1; then
                ported=$((ported + 1))
            elif [[ -z "$(unmerged_paths)" ]] && git diff --cached --quiet; then
                git cherry-pick --skip >/dev/null 2>&1 # already there: nothing to copy
            else
                git cherry-pick --abort >/dev/null 2>&1
                notPorted+=("$(git log -1 --format='%h %s' "$h")")
            fi
        done < <(own_base_commits "$mb")
    fi
    echonice "$repo: copied $ported own '$base' commit(s); ${#notPorted[@]} left for the LLM"
    STEPS_DONE+=("$ported own commit(s) of the old \`$base\` copied across (\`cherry-pick -x\`); ${#notPorted[@]} could not be copied automatically")

    ############ (c) old base becomes an ancestor: no force push needed, its content is NOT taken
    git merge -q -s ours --no-edit -m "Merge old '$base' into the SS6 rebuild from '$sourceBranch' (content from the rebuild; old '$base' kept in history)" "origin/$base" || {
        bail
        return 1
    }
    STEPS_DONE+=("Old \`$base\` merged with \`-s ours\`: it stays in the history (no force push), the content comes from the rebuild")

    ############ (d) what would be lost? apply the old SS6 upgrade where missing and bring back needed work
    if [[ "$useLlm" == 'yes' ]]; then
        ECHOHEAD "$repo: LLM comparison with the old $base"
        git diff HEAD "origin/$base" -- . ':!CHANGELOG.md' ':!composer.lock' >.agents/lost.diff
        cp .agents/prompt-lost.txt .agents/prompt-lost-repo.txt
        if ((${#notPorted[@]} > 0)); then
            {
                echo
                echo "Commits of the old '$base' that could not be copied automatically (inspect with: git show <hash>):"
                printf -- '- %s\n' "${notPorted[@]}"
            } >>.agents/prompt-lost-repo.txt
        fi
        run_llm "$PWD/.agents/prompt-lost-repo.txt" '.agents/lost.diff' || echowarn "LLM comparison exited non-zero"
        aborted && return 1
        if [[ -n "$(markers_remaining)" ]]; then
            echobad "conflict markers remain in: $(markers_remaining | tr '\n' ' ')"
            bail
            return 1
        fi
        git add -A
        git diff --cached --quiet || git commit -q -m "FIX: bring SS6 upgrade work and fixes across from the old '$base'"
        STEPS_DONE+=("LLM compared the result with the old \`$base\`: applied its SS6 upgrade where still missing and brought back needed work")
    elif ((${#notPorted[@]} > 0)); then
        echobad "$repo: ${#notPorted[@]} commit(s) from '$base' could not be copied and --no-llm is set: $(printf '%s; ' "${notPorted[@]}")"
        bail
        return 1
    fi

    finish_ss6 "$repo"
}

############ both paths: make sure it works with SS6, commit, push / PR
finish_ss6() {
    local repo=$1

    ECHOHEAD "$repo: rector $rectorConfig"
    if ! run_rector; then
        echobad "rector failed"
        bail
        return 1
    fi

    if [[ "$useLlm" == 'yes' ]]; then
        ECHOHEAD "$repo: LLM SS6 clean-up"
        run_llm "$PWD/.agents/prompt-cleanup.txt" 'composer.json' || echowarn "LLM clean-up exited non-zero"
        aborted && return 1
    fi
    STEPS_DONE+=("Rector (\`$rectorConfig\`) and an LLM SS6 clean-up")

    ECHOHEAD "$repo: verifying"
    if ! verify_all; then
        cat .agents/verify.txt
        if [[ "$useLlm" == 'yes' ]]; then
            echowarn "verification failed; one LLM repair attempt"
            printf 'Fix the problems listed in the attached verify.txt for this Silverstripe 6 module. Only edit what is needed. Do not change tests just to make them pass unless they test removed SS5 behaviour. Do not run git commands.\n' >.agents/prompt-repair.txt
            run_llm "$PWD/.agents/prompt-repair.txt" '.agents/verify.txt' || echowarn "LLM repair exited non-zero"
            aborted && return 1
        fi
        if ! verify_all; then
            cat .agents/verify.txt
            if [[ "$verifySoft" == 'yes' && "$verifyInstall" == 'yes' ]] && verify_module; then
                VERIFY_SUMMARY="**FAILED**: composer install / PHPUnit did not pass. Static checks passed. Details:"
                VERIFY_DETAIL=$(grep -A80 -E 'composer install FAILED|phpunit FAILED' .agents/verify.txt | head -n 100)
                echowarn "$repo: install/test verification failed (--verify-soft): continuing, recorded in the PR"
            else
                echobad "$repo: verification failed"
                bail
                return 1
            fi
        fi
    fi
    echogood "$repo: verification passed"
    STEPS_DONE+=("Verification: static checks passed (\`composer validate\`, \`php -l\`, no conflict markers). $VERIFY_SUMMARY")

    ############ commit (and push) the clean-up
    local msg="API: upgrade to Silverstripe 6 (brought $sourceBranch into $base)"
    if [[ -n "$(git status --porcelain)" ]]; then
        if [[ "$push" == 'yes' && "$prMode" != 'yes' ]]; then
            sake-git-commit-and-push -m "$msg" -v no -r no . || {
                echobad "$repo: sake-git-commit-and-push failed"
                return 1
            }
        else
            git add -A && git commit -q -m "$msg" || {
                bail
                return 1
            }
        fi
    fi
    echogood "$repo: committed on $(git rev-parse --abbrev-ref HEAD)"

    if [[ "$prMode" == 'yes' ]]; then
        open_pull_request "$repo" || return 1
        return 0
    fi

    if [[ "$push" == 'yes' ]]; then
        # the changelog commit on the source branch (the only change ever made to it)
        if git rev-parse -q --verify "refs/heads/$sourceBranch" >/dev/null &&
            [[ "$(git rev-parse "refs/heads/$sourceBranch")" != "$(git rev-parse "origin/$sourceBranch")" ]]; then
            git push origin "$sourceBranch" && echogood "$repo: pushed changelog commit on $sourceBranch" ||
                echowarn "$repo: could not push $sourceBranch"
        fi
        git fetch -q origin "$base"
        if [[ "$(git rev-parse "refs/heads/$base")" != "$(git rev-parse "origin/$base")" ]]; then
            # a normal (fast-forward) push in both paths: origin/base is always an ancestor
            git push origin "$base" || {
                echobad "$repo: push failed"
                return 1
            }
        fi
        echogood "$repo: pushed"
    fi
    return 0
}

# Work inside the cloned repo (cwd already set). Returns 0 = done, 1 = failed, 2 = left for a human (REPO_NOTE says why).
upgrade_repo() {
    local repo=$1 from n own mb exclude
    START_SHA='' STEPS_DONE=() REPO_NOTE='' PATH_USED='' PREP_SHA='' PREP_TIP='' PREP_BASE='' REMERGED=0 CHANGELOG_DONE='no'

    write_prompts "$PWD"
    exclude=$(git rev-parse --git-path info/exclude)
    grep -qxF '.agents/' "$exclude" 2>/dev/null || printf '.agents/\n' >>"$exclude"

    [[ "$strategy" == 'rebuild' ]] && {
        rebuild_path "$repo"
        return $?
    }

    ############ prep: Rector on scratch copies of the source branch and the merge base, then measure the real conflicts
    if [[ "$prep" == 'yes' ]]; then
        ECHOHEAD "$repo: Rector ($rectorConfig) on scratch copies of '$sourceBranch' and the merge base"
        prepare_source "origin/$sourceBranch"
    fi

    if [[ "$strategy" == 'auto' ]]; then
        if [[ -n "$PREP_BASE" ]]; then
            n=$(conflict_count "origin/$base" "$PREP_TIP" "$PREP_BASE")
        else
            n=$(conflict_count "origin/$base" "origin/$sourceBranch")
        fi
        echonice "$repo: conflicted files when merging now: $n (limit $conflictLimit)"
        if ((n > conflictLimit)); then
            mb=$(git merge-base "origin/$base" "origin/$sourceBranch" 2>/dev/null)
            own=0
            [[ -n "$mb" ]] && own=$(own_base_commits "$mb" | grep -c .)
            if [[ -z "$mb" ]] || ((own <= mainWorkLimit)); then
                echowarn "$repo: too many conflicts and '$base' has only $own own commit(s): rebuilding instead of merging"
                rebuild_path "$repo"
                return $?
            fi
            REPO_NOTE="$n conflicted files after the Rector prep AND $own own commits on '$base' (try --strategy merge or rebuild by hand)"
            return 2
        fi
    fi

    ############ changelog on the source branch, then put the Rector commit on top of it
    changelog_on_source "$repo" || return 1
    from=$sourceBranch
    if [[ -n "$PREP_SHA" ]]; then
        if [[ "$(git rev-parse "refs/heads/$sourceBranch")" == "$(git rev-parse "origin/$sourceBranch")" ]]; then
            from=$PREP_TIP
        elif git checkout -q --detach "$sourceBranch" && git cherry-pick "$PREP_SHA" >/dev/null 2>&1; then
            from=$(git rev-parse HEAD)
        else
            git cherry-pick --abort >/dev/null 2>&1
            prepare_source "$sourceBranch" && [[ -n "$PREP_SHA" ]] && from=$PREP_TIP
        fi
    fi

    merge_path "$repo" "$from"
}

############################################ RUN

for tool in gh git jq sake-llm-opencode sake-lint-php-rector sake-git-merge-towards-production-changes sake-git-commit-and-push; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echobad "Required tool not found: $tool"
        exit 1
    fi
done
gitVersion=$(git version | grep -oE '[0-9]+\.[0-9]+' | head -1)
if awk -v v="$gitVersion" 'BEGIN {split(v, a, "."); exit !(a[1] < 2 || (a[1] == 2 && a[2] < 40))}'; then
    echobad "git 2.40 or newer is needed (for git merge-tree --merge-base); you have $gitVersion"
    exit 1
fi

ECHOHEAD "LLM that will be used"
while IFS= read -r l; do echonice "$l"; done < <(effective_model)
if [[ "$useLlm" == 'yes' ]] && command -v opencode >/dev/null 2>&1; then
    effModel=$(effective_model | sed -n 's/^ *model: *//p' | head -1)
    effModel=${effModel%%#*}
    if [[ -n "$effModel" ]] && availableModels=$(opencode models 2>/dev/null) && [[ -n "$availableModels" ]] &&
        ! grep -Fxq -- "$effModel" <<<"$availableModels"; then
        echobad "Model not available in opencode: $effModel"
        echonice "Available models from the same provider (see 'opencode models'):"
        while IFS= read -r l; do echonice "   $l"; done < <(grep -F -- "${effModel%%/*}/" <<<"$availableModels")
        exit 1
    fi
fi

ECHOHEAD "Scanning $owner repos for '$sourceBranch' branches ahead of base"
mkdir -p "$workDir" || exit 1

# Strip an optional owner prefix ('sunnysideup-' / 'sunnysideup/') and an optional 'silverstripe-' prefix.
short_repo_name() {
    local n=${1// /}
    n=${n#"$owner"/}
    n=${n#"$owner"-}
    n=${n#silverstripe-}
    printf '%s' "$n"
}

# repo_in_list NAME "a,b,c": exact match, or match after dropping the optional prefixes on both sides
# ('ecommerce', 'silverstripe-ecommerce', 'sunnysideup-ecommerce' and 'sunnysideup-silverstripe-ecommerce' are all the same repo)
repo_in_list() {
    local name=$1 list=$2 item short
    short=$(short_repo_name "$name")
    local IFS=','
    for item in $list; do
        [[ -n "${item// /}" ]] || continue
        [[ "${item// /}" == "$name" || "$(short_repo_name "$item")" == "$short" ]] && return 0
    done
    return 1
}

mapfile -t repos < <(gh repo list "$owner" --limit "$limit" --no-archived --source \
    --json name,defaultBranchRef --jq '.[] | "\(.name) \(.defaultBranchRef.name // "main")"')

if [[ -n "$only" ]]; then
    filtered=()
    for line in "${repos[@]}"; do
        name=${line%% *}
        repo_in_list "$name" "$only" && filtered+=("$line")
    done
    repos=("${filtered[@]}")
fi

if [[ -n "$skip" ]]; then
    filtered=()
    for line in "${repos[@]}"; do
        name=${line%% *}
        repo_in_list "$name" "$skip" || filtered+=("$line")
    done
    repos=("${filtered[@]}")
fi

echonice "repos to check: ${#repos[@]}"

upgraded=() failed=() skipped=() candidates=() needsHuman=()

for line in "${repos[@]}"; do
    [[ -n "$line" ]] || continue
    name=${line%% *}
    defaultBranch=${line##* }
    base=${baseBranch:-$defaultBranch}
    repoDir="$workDir/$name"

    if [[ -d "$repoDir/.git" ]]; then
        git -C "$repoDir" fetch -q origin --prune 2>/dev/null || {
            skipped+=("$name (fetch failed)")
            continue
        }
    else
        # cheap existence check before cloning
        if ! git ls-remote --exit-code --heads "https://github.com/$owner/$name.git" "$sourceBranch" >/dev/null 2>&1; then
            [[ "$verbose" == 'yes' ]] && echonice "- $name: no '$sourceBranch' branch"
            continue
        fi
        # plain git (not 'gh repo clone'): snap-packaged gh cannot exec ssh
        cloneErr=$(git clone -q "https://github.com/$owner/$name.git" "$repoDir" 2>&1) || {
            echobad "$name: clone failed: $cloneErr"
            rm -rf "$repoDir"
            skipped+=("$name (clone failed)")
            continue
        }
    fi

    cd "$repoDir" || continue
    if ! git rev-parse -q --verify "origin/$sourceBranch" >/dev/null; then
        [[ "$verbose" == 'yes' ]] && echonice "- $name: no '$sourceBranch' branch"
        continue
    fi
    if ! git rev-parse -q --verify "origin/$base" >/dev/null; then
        skipped+=("$name (no base branch '$base')")
        continue
    fi

    aheadOfBase=$(git rev-list --count "origin/$base..origin/$sourceBranch")
    if ((aheadOfBase == 0)); then
        [[ "$verbose" == 'yes' ]] && echonice "- $name: '$sourceBranch' not ahead of '$base'"
        continue
    fi

    if [[ "$prMode" == 'yes' && "$forcePr" != 'yes' ]] &&
        git ls-remote --exit-code --heads origin "$prBranch" >/dev/null 2>&1; then
        existing=$(gh pr list --repo "$owner/$name" --head "$prBranch" --state open --json url --jq '.[0].url' 2>/dev/null)
        skipped+=("$name ('$prBranch' already on origin; ${existing:-no open PR - create one or use --force-pr})")
        continue
    fi

    assess_repo
    suggestion=$(suggest_strategy)
    echowarn "$name: '$sourceBranch' is $aheadOfBase commit(s) ahead of '$base'"
    echonice "   $A_LINE"
    echonice "   suggested: $suggestion"
    candidates+=("$name: $suggestion  [$A_LINE]")

    [[ "$dryRun" == 'yes' ]] && continue

    if ! ask_repo "$name"; then
        [[ "$QUIT" == 'yes' ]] && break
        skipped+=("$name (skipped by user)")
        continue
    fi

    git reset -q --hard
    git clean -fdq
    CURRENT_DIR="$repoDir"
    ABORT_REPO='no'
    costBefore=$(total_cost)
    VERIFY_DETAIL=''
    VERIFY_SUMMARY='static checks only (composer validate, php -l); dependencies were NOT installed and PHPUnit was NOT run'
    upgrade_repo "$name"
    rc=$?
    case $rc in
    0)
        upgraded+=("$name ($PATH_USED)")
        rm -rf "$(realpath -m "$workDir")/.salvage/$name"
        ;;
    2) needsHuman+=("$name: $REPO_NOTE") ;;
    *)
        failed+=("$name${PATH_USED:+ ($PATH_USED)}")
        # a failed rebuild resets its branch to the source branch: put base back where origin has it
        git checkout -q -f -B "$base" "origin/$base" 2>/dev/null
        ;;
    esac
    echonice "$name: LLM cost for this repo \$$(awk -v a="$(total_cost)" -v b="$costBefore" 'BEGIN {printf "%.4f", a-b}')"
    [[ "$QUIT" == 'yes' ]] && break
done

cd "$WORKING_DIR" || exit 1

############################################ SUMMARY

ECHOHEAD "Summary"
echonice "LLM total:       \$$(total_cost)  ($(total_tokens))"
echonice "ahead of base:   ${#candidates[@]}"
if [[ "$dryRun" == 'yes' ]]; then
    for n in "${candidates[@]}"; do echonice "  $n"; done
    echonice "(conflict counts above are for a plain merge; the Rector prep usually brings them down a lot)"
else
    echogood "upgraded:        ${#upgraded[@]}"
    for n in "${upgraded[@]}"; do echonice "  $n  ($workDir/${n%% *})"; done
    if ((${#needsHuman[@]} > 0)); then
        echowarn "needs a human:   ${#needsHuman[@]}"
        for n in "${needsHuman[@]}"; do echonice "  $n"; done
    fi
    if ((${#failed[@]} > 0)); then
        echobad "failed:          ${#failed[@]}"
        for n in "${failed[@]}"; do echonice "  $n"; done
    fi
fi
if ((${#skipped[@]} > 0)); then
    echowarn "skipped:         ${#skipped[@]}"
    for n in "${skipped[@]}"; do echonice "  $n"; done
fi
if ((${#PR_URLS[@]} > 0)); then
    ECHOHEAD "Pull requests to review"
    for n in "${PR_URLS[@]}"; do echonice "  $n"; done
fi
[[ "$push" == 'yes' || "$prMode" == 'yes' || "$dryRun" == 'yes' || ${#upgraded[@]} -eq 0 ]] || echonice "Nothing pushed. Review in $workDir, or re-run with --push."

echoend
