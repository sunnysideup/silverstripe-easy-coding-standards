#!/usr/bin/env bash

############################################ BASICS
SCRIPT_DIR="${COMPOSER_RUNTIME_BIN_DIR:?COMPOSER_RUNTIME_BIN_DIR not set}"
WORKING_DIR=$(pwd)
source "$SCRIPT_DIR/sake-self-methods"
SCRIPT_SUMMARY="Syncs database between local and remote server via SSH"

############################################ HELPERS
#
# ESCAPING MODEL (read before touching any ssh/mysql line):
#   * LOCAL mysql calls pass through ONE shell, so plain double quotes
#     ("$var") are enough — an expansion result is not re-scanned, so $, `,
#     ", \ inside a value are already safe.
#   * REMOTE calls pass through TWO shells (local build + remote parse). EVERY
#     value that lands there (user, password, host, db name, file path) is
#     run through escape_for_single_quotes and wrapped in SINGLE quotes on the
#     remote side. The DB name is passed as a mysql ARGUMENT and queries filter
#     with DATABASE(), so no value is ever interpolated into a remote
#     double-quoted string where $ or ` could be re-expanded.
#   * BACKUP location (see prepare_remote_backup_dump): user-controlled config,
#     split into dir + filename and single-quoted on the remote just like every
#     other value. A wildcard filename (e.g. *.sql.gz) is matched by `find
#     -name` itself, NOT by the remote shell — that is why single-quoting the
#     pattern is correct AND safe: find does the globbing, the shell never does.
#
# Build a single DROP script from newline-separated table & view name lists.
# FOREIGN_KEY_CHECKS is toggled inside the same script so it applies to the
# whole session (must be one mysql invocation, not several).
build_drop_sql() {
    local tables="$1" views="$2"
    local sql line
    sql="SET FOREIGN_KEY_CHECKS=0;"$'\n'
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        sql+="DROP TABLE IF EXISTS \`$line\`;"$'\n'
    done <<<"$tables"
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        sql+="DROP VIEW IF EXISTS \`$line\`;"$'\n'
    done <<<"$views"
    sql+="SET FOREIGN_KEY_CHECKS=1;"$'\n'
    printf '%s' "$sql"
}

# Drop every base table & view from a LOCAL database.
# DB selected as an argument + DATABASE() filter → the name never enters the
# SQL text, and the single-column result means no pipe masks mysql's exit code.
drop_all_tables_local() {
    local user="$1" pass="$2" host="$3" db="$4"
    local tables views
    tables=$(mysql --skip-column-names --batch -u "$user" -p"$pass" -h "$host" "$db" -e \
        "SELECT table_name FROM information_schema.tables WHERE table_schema = DATABASE() AND table_type = 'BASE TABLE';") || return 1
    views=$(mysql --skip-column-names --batch -u "$user" -p"$pass" -h "$host" "$db" -e \
        "SELECT table_name FROM information_schema.views WHERE table_schema = DATABASE();") || return 1
    if [[ -z "$tables" && -z "$views" ]]; then
        echonice "Local database '$db' has no tables/views — nothing to drop."
        return 0
    fi
    build_drop_sql "$tables" "$views" | mysql -u "$user" -p"$pass" -h "$host" "$db"
}

# Drop every base table & view from a REMOTE database (over SSH).
# All four connection fields are escaped for single quotes; the DB is passed as
# an arg and DATABASE() does the filtering, so the remote -e string is a plain
# constant (no $, no `) and can safely sit in remote double quotes.
drop_all_tables_remote() {
    local sshHost="$1"
    local eu ep eh ed tables views
    eu=$(escape_for_single_quotes "$2")
    ep=$(escape_for_single_quotes "$3")
    eh=$(escape_for_single_quotes "$4")
    ed=$(escape_for_single_quotes "$5")
    tables=$(ssh "$sshHost" "mysql --skip-column-names --batch -u '$eu' -p'$ep' -h '$eh' '$ed' -e \"SELECT table_name FROM information_schema.tables WHERE table_schema = DATABASE() AND table_type = 'BASE TABLE';\"") || return 1
    views=$(ssh "$sshHost" "mysql --skip-column-names --batch -u '$eu' -p'$ep' -h '$eh' '$ed' -e \"SELECT table_name FROM information_schema.views WHERE table_schema = DATABASE();\"") || return 1
    if [[ -z "$tables" && -z "$views" ]]; then
        echonice "Remote database '$5' (@ $sshHost) has no tables/views — nothing to drop."
        return 0
    fi
    build_drop_sql "$tables" "$views" | ssh "$sshHost" "mysql -u '$eu' -p'$ep' -h '$eh' '$ed'"
}

# Read one KEY from a remote .env over SSH. Path escaped + single-quoted on the
# remote so spaces are safe. head -n1 guards against duplicate keys.
read_remote_dotenv_value() {
    local sshHost="$1" envFile="$2" key="$3"
    local ef
    ef=$(escape_for_single_quotes "$envFile")
    ssh "$sshHost" "grep '^$key=' '$ef' | head -n1 | cut -d '=' -f 2- | tr -d '\"'"
}

# Prepare the standard remote dump file FROM A BACKUP instead of a live
# mysqldump. Used only on a PULL (source → local); reverse sync never touches
# this because there we dump the LOCAL database.
#
# The backup "location" is either an explicit --backup-location argument or the
# SS_DATABASE_SERVER_BACKUP_LOCATION .env value. It may be:
#   * a literal path  ...databases/backup-2026-08-24.sql.gz
#   * a wildcard      ...databases/*.sql.gz      (newest match wins)
#   * plain or gzipped (*.gz is decompressed, anything else is copied as-is)
#
# ESCAPING MODEL: the location is split locally with dirname/basename, and BOTH
# parts are escape_for_single_quotes'd + wrapped in SINGLE quotes on the remote,
# so $, `, ", \ stay literal. The wildcard is matched by `find -name` itself
# (not the remote shell) precisely because the pattern is single-quoted — this
# supports a rotating "latest" dir with a random filename WITHOUT ever letting
# the remote shell expand user config.
#
# Requires GNU find on the remote for -printf (standard on Debian/Ubuntu
# containers). Assumes the backup path contains no embedded newlines.
prepare_remote_backup_dump() {
    local sshHost="$1" location="$2" dumpFile="$3"
    local dir base edir ebase edump resolved eresolved

    dir=$(dirname -- "$location")
    base=$(basename -- "$location")
    edir=$(escape_for_single_quotes "$dir")
    ebase=$(escape_for_single_quotes "$base")
    edump=$(escape_for_single_quotes "$dumpFile")

    # Resolve the (possibly wildcarded) location to the NEWEST matching file.
    # find does its own -name matching, so the single-quoted pattern is safe.
    resolved=$(ssh "$sshHost" "find '$edir' -maxdepth 1 -type f -name '$ebase' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-")
    if [[ -z "$resolved" ]]; then
        echobad "No backup file matching '$location' found on $sshHost."
        return 1
    fi
    echonice "Using backup file: $resolved"

    eresolved=$(escape_for_single_quotes "$resolved")

    # Decompress *.gz, else copy a plain *.sql, into the standard remote dump
    # file — after this the rest of the PULL flow is identical to a live dump.
    # -- guards filenames starting with '-'. The case word is the single-quoted
    # literal path, so the value itself is never glob-expanded by the shell.
    ssh "$sshHost" "
        if [ ! -r '$eresolved' ]; then echo 'backup file not readable: $eresolved' >&2; exit 1; fi
        case '$eresolved' in
            *.gz) gunzip -c -- '$eresolved' > '$edump' ;;
            *)    cp -- '$eresolved' '$edump' ;;
        esac
    " || return 1
}

############################################ DIR
localEnvFile="$WORKING_DIR/.env"
remoteDumpFile="/tmp/db_dump.sql"
localDumpFile="/tmp/db_dump.sql"
toRemoteDumpFile="/tmp/db_dump_from_local.sql"
envServerKey='SS_SERVER_FOR_EXAMPLE_DATA'
envBackupKey='SS_DATABASE_SERVER_BACKUP_LOCATION'

############################################ SETTINGS
server=''
toServer=''
help='no'
reverse='no'
dropDb='no'
useBackup='no'
backupLocation=''
backupLocationFromArg=''

serverFromArg=''
while (($#)); do
    case $1 in
    -r | --reverse)
        reverse='yes'
        ;;
    -t | --to)
        toServer=$2
        shift
        ;;
    -d | --drop)
        dropDb='yes'
        ;;
    -b | --backup)
        useBackup='yes'
        ;;
    --backup-location)
        # Explicit path/glob to the backup on the source server. Implies -b.
        backupLocationFromArg=$2
        useBackup='yes'
        shift
        ;;
    *)
        if sake_handle_help_flag "$1"; then
            shift
            continue
        fi
        serverFromArg=$1
        ;;
    esac

    shift
done

# Backups live on the SOURCE server and are only meaningful when pulling FROM it.
# Reverse sync dumps the LOCAL db, so the two options are mutually exclusive.
if [[ "$useBackup" == "yes" && "$reverse" == "yes" ]]; then
    echobad "--backup cannot be combined with --reverse (backups are pulled FROM the source server only)."
    exit 1
fi

############################################ RESOLVE SERVER (arg ALWAYS overrules .env)
serverFromEnv="$(read_local_dotenv_value "$envServerKey" || true)"
if [[ -n "$serverFromArg" ]]; then
    server="$serverFromArg"
    serverSource="argument"
    if [[ -n "$serverFromEnv" && "$(normalize_server "$serverFromArg")" != "$(normalize_server "$serverFromEnv")" ]]; then
        echowarn "Note: argument server ($serverFromArg) differs from .env $envServerKey ($serverFromEnv)."
        echowarn "Using the argument server."
    fi
elif [[ -n "$serverFromEnv" ]]; then
    server="$serverFromEnv"
    serverSource=".env ($envServerKey)"
else
    echobad 'No server specified (no argument, no .env value).'
    echowarn "Set a default in .env: $envServerKey=my-server:/var/www/website-root"
    exit 1
fi
server="$(normalize_server "$server")"

if [[ -z "$server" || "$help" == "yes" ]]; then
    ECHOHEAD "Sync Database"
    echonice "Syncs MySQL database between local and remote server via dump files"
    echonice ""
    echonice "Directory of script:           $SCRIPT_DIR"
    echonice "Server to sync with:           $server"
    echonice "Do reverse sync:               $reverse"
    echonice "To server (if any):            $toServer"
    echonice "Drop & recreate whole DB:      $dropDb"
    echonice "Use backup (not live dump):    $useBackup"
    echonice "Backup location (arg):         ${backupLocationFromArg:-<none; will use .env if -b set>}"
    echonice "Apache user (-w):              $wwwDataUser"
    echonice ""
    echonice "Local .env File:               $localEnvFile"
    echonice "Remote dump file:              $remoteDumpFile"
    echonice "Local dump file:               $localDumpFile"
    echonice "To server dump file:           $toRemoteDumpFile"

    echonice ""
    ECHOHEAD "Available settings:"
    echonice "-r, --reverse                  sync FROM local TO server"
    echonice "-t, --to SERVER[:/path]        after pulling, also push dump to this server and import"
    echonice "-d, --drop                     DROP & recreate the whole DB before import (needs DROP/CREATE DATABASE privilege)"
    echonice "-b, --backup                   pull the DB from the latest server BACKUP instead of a live mysqldump"
    echonice "    --backup-location PATH      explicit path/glob to the backup .sql(.gz) on the source server (implies -b)"
    echonice "-h, --help                     show help information"
    echonice ""
    echonice "Note: on every import, ALL tables/views are dropped from the target DB first,"
    echonice "      so any extra / superfluous tables are removed. This applies to the LOCAL,"
    echonice "      the SOURCE server (reverse), and the --to server."
    echonice "      Use -d to instead DROP & recreate the entire database (resets"
    echonice "      charset / collation / grants; requires DROP + CREATE DATABASE privilege)."
    echonice ""
    echonice "Backup mode (-b / --backup-location) only applies to a PULL (source → local,"
    echonice "      and any --to server). It restores from a dump FILE on the source server"
    echonice "      instead of running mysqldump live. A *.gz backup is decompressed"
    echonice "      automatically; if the filename is a wildcard the NEWEST match is used."
    echonice ""
    ECHOHEAD "Examples:"
    echonice "sake-ss-rsync-db my-server:/var/www/website-root"
    echonice "sake-ss-rsync-db my-server            # default path is \$DEFAULT_SERVER_DIR ($DEFAULT_SERVER_DIR)"
    echonice "sake-ss-rsync-db --reverse my-server"
    echonice "sake-ss-rsync-db --reverse --drop my-server"
    echonice "sake-ss-rsync-db my-server --to other-server:/var/www/site"
    echonice "sake-ss-rsync-db my-server -b        # restore from latest backup on my-server"
    echonice "sake-ss-rsync-db my-server --backup-location '/container/backups/containers/latest/databases/*.sql.gz'"

    ECHOHEAD "Setting defaults:"
    echonice "Set default server in .env with key $envServerKey,"
    echonice " e.g. $envServerKey=my-server:/var/www/website-root"
    echonice ""
    echonice "Set default backup location with key $envBackupKey."
    echonice "This is read from the SOURCE server's .env first, then the local .env, e.g."
    echonice " $envBackupKey=/container/backups/containers/latest/databases/*.sql.gz"
    echofunctions
    exit
fi

sake_check_help_and_exit

serverClean=$(echo "$server" | cut -d':' -f1)
REMOTE_DIR=$(echo "$server" | cut -s -d':' -f2)
REMOTE_DIR=${REMOTE_DIR:-$DEFAULT_SERVER_DIR}
REMOTE_ENV_FILE="$REMOTE_DIR/.env"

# If --to provided, normalize it as well
if [[ -n "$toServer" ]]; then
    [[ "$toServer" != *":/"* ]] && toServer="$toServer:$DEFAULT_SERVER_DIR"
    toServerClean=$(echo "$toServer" | cut -d':' -f1)
    TO_REMOTE_DIR=$(echo "$toServer" | cut -s -d':' -f2)
    TO_REMOTE_DIR=${TO_REMOTE_DIR:-$DEFAULT_SERVER_DIR}
    TO_REMOTE_ENV_FILE="$TO_REMOTE_DIR/.env"
fi

############################################ EXTRACT .env VARIABLES

localDbUser=$(read_local_dotenv_value "SS_DATABASE_USERNAME")
localDbPass=$(read_local_dotenv_value "SS_DATABASE_PASSWORD")
localDbName=$(read_local_dotenv_value "SS_DATABASE_NAME")
localDbHost="$(read_local_dotenv_value 'SS_DATABASE_SERVER' || true)"
localDbHost="${localDbHost:-localhost}"

remoteDbUser=$(read_remote_dotenv_value "$serverClean" "$REMOTE_ENV_FILE" "SS_DATABASE_USERNAME")
remoteDbPass=$(read_remote_dotenv_value "$serverClean" "$REMOTE_ENV_FILE" "SS_DATABASE_PASSWORD")
remoteDbName=$(read_remote_dotenv_value "$serverClean" "$REMOTE_ENV_FILE" "SS_DATABASE_NAME")
remoteDbHost=$(read_remote_dotenv_value "$serverClean" "$REMOTE_ENV_FILE" "SS_DATABASE_SERVER")

if [[ -z "$remoteDbUser" || -z "$remoteDbPass" || -z "$remoteDbName" || -z "$remoteDbHost" ]]; then
    echobad "Could not retrieve database credentials from the source server."
    exit 1
else
    echonice "Retrieved source server DB credentials:"
    echonice "  User: $remoteDbUser"
    echonice "  Name: $remoteDbName"
    echonice "  Host: $remoteDbHost"
    echonice "  Password: ******"
fi

if [[ -z "$localDbUser" || -z "$localDbPass" || -z "$localDbName" || -z "$localDbHost" ]]; then
    echobad "Could not retrieve database credentials from the local .env file."
    exit 1
fi

############################################ RESOLVE BACKUP LOCATION (arg > remote .env > local .env)
if [[ "$useBackup" == "yes" ]]; then
    if [[ -n "$backupLocationFromArg" ]]; then
        backupLocation="$backupLocationFromArg"
        backupSource="argument (--backup-location)"
    else
        backupLocation="$(read_remote_dotenv_value "$serverClean" "$REMOTE_ENV_FILE" "$envBackupKey")"
        if [[ -n "$backupLocation" ]]; then
            backupSource="remote .env ($envBackupKey)"
        else
            backupLocation="$(read_local_dotenv_value "$envBackupKey" || true)"
            [[ -n "$backupLocation" ]] && backupSource="local .env ($envBackupKey)"
        fi
    fi

    if [[ -z "$backupLocation" ]]; then
        echobad "Backup mode requested but no backup location found."
        echowarn "Provide --backup-location PATH, or set $envBackupKey in the source or local .env, e.g."
        echowarn "  $envBackupKey=/container/backups/containers/latest/databases/*.sql.gz"
        exit 1
    fi

    echonice "Backup mode: ON"
    echonice "  Location: $backupLocation"
    echonice "  Source:   $backupSource"
fi

# Pre-escape every source-server field once, for safe reuse inside ssh "..." strings.
escRemoteUser=$(escape_for_single_quotes "$remoteDbUser")
escRemotePass=$(escape_for_single_quotes "$remoteDbPass")
escRemoteHost=$(escape_for_single_quotes "$remoteDbHost")
escRemoteName=$(escape_for_single_quotes "$remoteDbName")
escRemoteDump=$(escape_for_single_quotes "$remoteDumpFile")

# If --to: fetch its DB credentials now
if [[ -n "$toServer" ]]; then
    toRemoteDbUser=$(read_remote_dotenv_value "$toServerClean" "$TO_REMOTE_ENV_FILE" "SS_DATABASE_USERNAME")
    toRemoteDbPass=$(read_remote_dotenv_value "$toServerClean" "$TO_REMOTE_ENV_FILE" "SS_DATABASE_PASSWORD")
    toRemoteDbName=$(read_remote_dotenv_value "$toServerClean" "$TO_REMOTE_ENV_FILE" "SS_DATABASE_NAME")
    toRemoteDbHost=$(read_remote_dotenv_value "$toServerClean" "$TO_REMOTE_ENV_FILE" "SS_DATABASE_SERVER")
    if [[ -z "$toRemoteDbUser" || -z "$toRemoteDbPass" || -z "$toRemoteDbName" || -z "$toRemoteDbHost" ]]; then
        echobad "Could not retrieve database credentials from the --to server."
        exit 1
    fi
    escToUser=$(escape_for_single_quotes "$toRemoteDbUser")
    escToPass=$(escape_for_single_quotes "$toRemoteDbPass")
    escToHost=$(escape_for_single_quotes "$toRemoteDbHost")
    escToName=$(escape_for_single_quotes "$toRemoteDbName")
    escToDump=$(escape_for_single_quotes "$toRemoteDumpFile")
fi

############################################ SYNC PROCESS
if [[ "$reverse" == "yes" ]]; then
    ECHOHEAD "DANGER: REVERSE SYNC (LOCAL → REMOTE)"
    echowarn "Target server:        $server"
    echowarn "Server source:        $serverSource"
    echowarn "Remote DB:            $remoteDbName @ $remoteDbHost (user: $remoteDbUser)"
    echowarn "You are about to OVERWRITE the remote database with your LOCAL database."
    if [[ "$dropDb" == "yes" ]]; then
        echowarn "The remote database will be DROPPED and recreated."
    else
        echowarn "ALL tables/views in the remote database will be dropped before import."
    fi
    read -p "Type the server host name ($serverClean) to confirm: " confirm
    [[ "$confirm" != "$serverClean" ]] && echonice "Aborted (input did not match server host)." && exit 1

    echonice "Dumping local database..."
    mysqldump --no-tablespaces --add-drop-table -u "$localDbUser" -p"$localDbPass" -h "$localDbHost" "$localDbName" >"$localDumpFile"
    [[ $? -ne 0 ]] && echobad "Local database dump failed." && exit 1

    echonice "Uploading dump to source server..."
    rsync -chavzP "$localDumpFile" "$serverClean:$remoteDumpFile" || {
        echobad "Failed to upload dump."
        exit 1
    }

    if [[ "$dropDb" == "yes" ]]; then
        echonice "Recreating database on source server..."
        ssh "$serverClean" "mysql -u '$escRemoteUser' -p'$escRemotePass' -h '$escRemoteHost' -e 'DROP DATABASE IF EXISTS \`$escRemoteName\`; CREATE DATABASE \`$escRemoteName\`;'" || {
            echobad "Failed to recreate database on source server."
            exit 1
        }
    else
        echonice "Dropping all tables on source server ($remoteDbName)..."
        drop_all_tables_remote "$serverClean" "$remoteDbUser" "$remoteDbPass" "$remoteDbHost" "$remoteDbName" || {
            echobad "Failed to drop tables on source server."
            exit 1
        }
    fi

    echonice "Importing on source server..."
    ssh "$serverClean" "mysql -u '$escRemoteUser' -p'$escRemotePass' -h '$escRemoteHost' '$escRemoteName' < '$escRemoteDump'" || {
        echobad "Failed to import on source server."
        exit 1
    }
else
    # PULL: source server -> local
    if [[ "$useBackup" == "yes" ]]; then
        # Restore the standard remote dump file FROM A BACKUP instead of a live
        # mysqldump. From here on the flow (download, drop, import) is identical.
        echonice "Preparing dump from BACKUP on source server ($backupLocation)..."
        prepare_remote_backup_dump "$serverClean" "$backupLocation" "$remoteDumpFile" || {
            echobad "Failed to prepare dump from backup on source server."
            exit 1
        }
    else
        echonice "Dumping remote database (source)..."
        ssh "$serverClean" "mysqldump --column-statistics=0 --no-tablespaces --add-drop-table -u '$escRemoteUser' -p'$escRemotePass' -h '$escRemoteHost' '$escRemoteName' > '$escRemoteDump'" || {
            echobad "Remote database dump failed."
            exit 1
        }
    fi

    echonice "Downloading dump from source server..."
    rsync -chavzP "$serverClean:$remoteDumpFile" "$localDumpFile" || {
        echobad "Failed to download dump."
        exit 1
    }

    # Local is always emptied first: every table/view is dropped so that no
    # superfluous / additional data survives the import.
    echonice "Ensuring local database exists..."
    mysql -u "$localDbUser" -p"$localDbPass" -h "$localDbHost" -e "CREATE DATABASE IF NOT EXISTS \`$localDbName\`;" || {
        echobad "Failed to ensure local database exists."
        exit 1
    }

    echonice "Dropping all tables from local database ($localDbName)..."
    drop_all_tables_local "$localDbUser" "$localDbPass" "$localDbHost" "$localDbName" || {
        echobad "Failed to drop local tables."
        exit 1
    }

    echonice "Importing locally..."
    mysql -u "$localDbUser" -p"$localDbPass" -h "$localDbHost" "$localDbName" <"$localDumpFile" || {
        echobad "Failed to import locally."
        exit 1
    }

    # If --to provided: send THIS downloaded dump to the --to server and import there
    if [[ -n "$toServer" ]]; then
        echowarn "Also importing the same dump into --to server ($toServer)..."

        if [[ "$dropDb" == "yes" ]]; then
            echonice "Recreating database on --to server..."
            ssh "$toServerClean" "mysql -u '$escToUser' -p'$escToPass' -h '$escToHost' -e 'DROP DATABASE IF EXISTS \`$escToName\`; CREATE DATABASE \`$escToName\`;'" || {
                echobad "Failed to recreate database on --to server."
                exit 1
            }
        else
            echonice "Dropping all tables on --to server ($toRemoteDbName)..."
            drop_all_tables_remote "$toServerClean" "$toRemoteDbUser" "$toRemoteDbPass" "$toRemoteDbHost" "$toRemoteDbName" || {
                echobad "Failed to drop tables on --to server."
                exit 1
            }
        fi

        rsync -chavzP "$localDumpFile" "$toServerClean:$toRemoteDumpFile" || {
            echobad "Failed to upload dump to --to server."
            exit 1
        }

        ssh "$toServerClean" "mysql -u '$escToUser' -p'$escToPass' -h '$escToHost' '$escToName' < '$escToDump'" || {
            echobad "Failed to import on --to server."
            exit 1
        }

        # Clean up on --to server
        ssh "$toServerClean" "rm -f '$escToDump'" || echowarn "Failed to clean up dump on --to server."
    fi
fi

############################################ CLEANUP (source server + local)
echonice "Cleaning up remote dump file on source server..."
ssh "$serverClean" "rm -f '$escRemoteDump'" || echowarn "Failed to clean up the remote dump file."

echonice "Cleaning up local dump file..."
rm -f "$localDumpFile" || echowarn "Failed to clean up the local dump file."

echonice "Database sync completed successfully."
echoend
