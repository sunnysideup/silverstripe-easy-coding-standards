{
  "name": "sunnysideup/easy-coding-standards",
  "type": "silverstripe-vendormodule",
  "description": "ECS PHP Linting.",
  "keywords": [
    "Silverstripe-CMS",
    "CMS",
    "Silverstripe",
    "PHP",
    "Linting",
    "linter",
    "clean",
    "easy coding standards",
    "PHP-CS-Fixer",
    "PHP_CodeSniffer",
    "phpstan"
  ],
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Nicolaas Francken",
      "email": "modules@sunnysideup.co.nz",
      "role": "lead developer"
    }
  ],
  "require": {
    "phan/phan": "*@stable",
    "pheromone/phpcs-security-audit": "*",
    "phpcompatibility/php-compatibility": "dev-develop",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-strict-rules": "*",
    "rector/rector": "^2.3",
    "squizlabs/php_codesniffer": "^4",
    "sunnysideup/env-file-generator": "dev-main",
    "symplify/easy-coding-standard": "^13.0",
    "cambis/silverstan": "*",
    "phpstan/extension-installer": "*",
    "wernerkrauss/silverstripe-rector": "dev-main",
    "friendsofphp/php-cs-fixer": "*"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "bin": [
    "bin/sake-composer-package-about",
    "bin/sake-composer-package-fork-comparison",
    "bin/sake-composer-package-require",
    "bin/sake-composer-update",
    "bin/sake-composer-update-available",
    "bin/sake-composer-update-force",
    "bin/sake-find-in-files",
    "bin/sake-find-large-files",
    "bin/sake-find-large-folders",
    "bin/sake-git-commit-and-push",
    "bin/sake-git-commit-and-push-vendor-packages",
    "bin/sake-git-commit-quick",
    "bin/sake-git-commit-tag",
    "bin/sake-git-info",
    "bin/sake-git-info-prod-diff",
    "bin/sake-git-merge-majors",
    "bin/sake-git-merge-pipeline-ssh",
    "bin/sake-git-merge-towards-production",
    "bin/sake-git-merge-towards-production-changes",
    "bin/sake-git-pm-add-collaborator",
    "bin/sake-git-pm-diff",
    "bin/sake-git-pm-diff-analyser",
    "bin/sake-git-pm-diff-recent",
    "bin/sake-git-pm-find-any-changes",
    "bin/sake-git-pm-fix-bitbucket-ssh",
    "bin/sake-git-pm-master-to-main",
    "bin/sake-git-pm-my-pull-requests",
    "bin/sake-git-pm-my-work-being-forked",
    "bin/sake-git-pm-scrutinizer-add",
    "bin/sake-git-squash-and-pr",
    "bin/sake-git-squash-commits",
    "bin/sake-git-squash-stale-branches",
    "bin/sake-git-upgrade-5-to-6-all",
    "bin/sake-help",
    "bin/sake-lint-class-namespacing",
    "bin/sake-lint-class-psr-4-checker",
    "bin/sake-lint-class-rename-comparison",
    "bin/sake-lint-files-js",
    "bin/sake-lint-files-remove-origs",
    "bin/sake-lint-php-compat",
    "bin/sake-lint-php-ecs",
    "bin/sake-lint-php-phan",
    "bin/sake-lint-php-rector",
    "bin/sake-lint-php-security",
    "bin/sake-lint-php-stan",
    "bin/sake-lint-run-all",
    "bin/sake-lint-run-one-file",
    "bin/sake-lint-ss-ide-annotator",
    "bin/sake-lint-ss-template-check",
    "bin/sake-llm-add-agents-file",
    "bin/sake-llm-opencode",
    "bin/sake-npm-build",
    "bin/sake-npm-build-dev",
    "bin/sake-npm-build-watch",
    "bin/sake-npm-package-audit",
    "bin/sake-npm-package-install",
    "bin/sake-npm-package-publish-on-npmjs-org",
    "bin/sake-php-config-switch-versions",
    "bin/sake-php-config-timezone",
    "bin/sake-php-line-counter",
    "bin/sake-self-methods",
    "bin/sake-self-update",
    "bin/sake-server-management-check-basics",
    "bin/sake-ss-build-dev",
    "bin/sake-ss-build-flush",
    "bin/sake-ss-contribute-step-1",
    "bin/sake-ss-contribute-step-2",
    "bin/sake-ss-db-dump",
    "bin/sake-ss-db-export",
    "bin/sake-ss-db-import",
    "bin/sake-ss-db-open",
    "bin/sake-ss-rsync-all",
    "bin/sake-ss-rsync-assets",
    "bin/sake-ss-rsync-db",
    "bin/sake-ss-rsync-sspak",
    "bin/sake-ss-start-env-file",
    "bin/sake-ss-start-new-feature",
    "bin/sake-ss-start-new-module",
    "bin/sake-ss-start-new-site",
    "bin/sake-ss-start-test-site",
    "bin/sake-ss-upgrade-align-versions",
    "bin/sake-ss-upgrade-install-upgrader",
    "bin/sake-ss-upgrade-ready",
    "bin/sake-ss-upgrade-security-update",
    "bin/sake-test-speed-server",
    "bin/sake-test-speed-site",
    "bin/sake-update-app-chromium",
    "bin/sake-update-app-shell",
    "bin/sake-update-app-vs-code",
    "bin/sake-update-runtime-composer",
    "bin/sake-update-runtime-go",
    "bin/sake-update-runtime-npm"
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": false,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "Sunnysideup\\EasyCodingStandards\\": "src/"
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:sunnysideup/silverstripe-rector.git"
    }
  ]
}
